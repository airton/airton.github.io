---
/*
  English plugin page. Every search query these pages surface for is English,
  so this is the version that has to be indexable on its own URL rather than
  buried in a Portuguese document.
*/
import PluginArticle from "@/components/PluginArticle.astro";
import { plugins } from "@/data/plugins";

export async function getStaticPaths() {
  return plugins.map((plugin) => ({
    params: { slug: plugin.slug },
    props: { plugin },
  }));
}

const { plugin } = Astro.props;

---

<PluginArticle plugin={plugin} lang="en" />

---
import Layout from "@/layouts/Layout.astro";
import GeminiDownloader from "@/components/GeminiDownloader.astro";
import { geminiJsonLd, GEMINI_ALTERNATES } from "@/helpers/geminiSeo";

const SEO_TITLE =
  "Bulk Image Downloader for Gemini Flow — Chrome Extension (.zip)";
const SEO_DESC =
  "Free Chrome extension that bulk-downloads every image generated in Google Gemini / Flow in one click, packed into a single .zip file.";
const OG_IMAGE = new URL(
  "/assets/images/gemini-flow-downloader-og.png",
  Astro.site
).toString();
---

<Layout
  title={SEO_TITLE}
  description={SEO_DESC}
  image={OG_IMAGE}
  lang="en"
  alternates={GEMINI_ALTERNATES}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      geminiJsonLd({
        lang: "en",
        description: SEO_DESC,
        image: OG_IMAGE,
        site: Astro.site!,
      })
    )}
  />
  <GeminiDownloader lang="en" />
</Layout>

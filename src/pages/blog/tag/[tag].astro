---
import MinimalPage from "@/components/MinimalPage.astro";
import PostList from "@/components/PostList.astro";
import { getCollection } from "astro:content";
import { slugify } from "@/helpers/slugify";
import { TAG_INDEX_MIN_POSTS } from "@/data/tags";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog");

  const tagMap = new Map<string, { label: string; posts: typeof posts }>();

  posts.forEach((post) => {
    (post.data.tags || []).forEach((tag) => {
      const tagSlug = slugify(tag);
      const entry = tagMap.get(tagSlug);
      if (entry) {
        entry.posts.push(post);
      } else {
        tagMap.set(tagSlug, { label: tag, posts: [post] });
      }
    });
  });

  return Array.from(tagMap.entries()).map(([tagSlug, { label, posts }]) => ({
    params: { tag: tagSlug },
    props: {
      label,
      posts: posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}) satisfies GetStaticPaths;

const { label, posts } = Astro.props;

/*
  A tag holding one or two posts is an archive with nothing in it. Keeping it
  crawlable but out of the index preserves reader navigation without offering
  Google a ~140-word page to compete with the articles themselves.
*/
const thin = posts.length < TAG_INDEX_MIN_POSTS;
---

<MinimalPage
  title={`${label} | Airton Vancin`}
  description={`Every post about ${label} on Airton Vancin's blog: web development, software architecture and technology.`}
  heading={`#${label}`}
  subheading={`${posts.length} ${posts.length === 1 ? "post" : "posts"}`}
  backLabel="← All tags"
  backHref="/blog/tags/"
  noindex={thin}
>
  <div class="mb-6">
    <PostList posts={posts} />
  </div>
</MinimalPage>

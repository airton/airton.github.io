---
import MinimalPage from "@/components/MinimalPage.astro";
import { getCollection } from "astro:content";
import { slugify } from "@/helpers/slugify";

const posts = await getCollection("blog");

const tagMap = new Map<string, { label: string; count: number }>();

posts.forEach((post) => {
  (post.data.tags || []).forEach((tag) => {
    const tagSlug = slugify(tag);
    const entry = tagMap.get(tagSlug);
    if (entry) {
      entry.count += 1;
    } else {
      tagMap.set(tagSlug, { label: tag, count: 1 });
    }
  });
});

const tags = Array.from(tagMap.entries())
  .map(([tagSlug, { label, count }]) => ({ tagSlug, label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
---

<MinimalPage
  title="Tags | Airton Vancin"
  description="Every topic on Airton Vancin's blog: React, TypeScript, WordPress, AWS, software architecture and more."
  heading="Tags"
  subheading="Browse posts by topic"
  backLabel="← Writing"
  backHref="/blog/"
>
  <section class="mb-16">
    <h2 class="term-title"><span aria-hidden="true">~/</span>tags</h2>
    <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
      {
        tags.map(({ tagSlug, label, count }) => (
          <li>
            <a href={`/blog/tag/${tagSlug}/`} class="group flex items-baseline justify-between gap-4 py-2.5">
              <span class="text-base group-hover:underline underline-offset-4">#{label}</span>
              <span class="text-xs text-quiet dark:text-quiet-lifted tabular-nums">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</MinimalPage>

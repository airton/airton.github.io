---
import MinimalPage from "@/components/MinimalPage.astro";
import PostList from "@/components/PostList.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<MinimalPage
  title="Writing | Airton Vancin"
  description="Articles by Airton Vancin on web development, software architecture, WordPress, AWS and AI, mostly in Portuguese."
  heading="Writing"
  subheading={`${posts.length} posts, mostly in Portuguese`}
>
  <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
    <p>
      Notes on web development, software architecture and what I learn while building. Browse by
      <a href="/blog/tags/" class="quiet-link">tag</a> or subscribe via <a href="/rss.xml" class="quiet-link">RSS</a>.
    </p>
  </section>

  <div class="mb-6">
    <PostList posts={posts} groupByYear />
  </div>
</MinimalPage>

---
import Layout from "../layouts/Layout.astro";
import SiteShell from "../components/SiteShell.astro";

const labels = {
  kicker: "Erro 404",
  heading: "Perdido no espaço?",
  description:
    "A página que você está procurando não existe ou foi movida para uma galáxia diferente.",
  back_home: "Voltar para Início",
  search_plugins: "Ver Plugins",
  search_projects: "Ver Projetos",
};
---

<Layout
  title="404 - Página não encontrada | Airton Vancin"
  description="A página que você está procurando não existe."
  lang="pt-BR"
  noindex
  noAds
  minimalNav={true}
  hideFooter={true}
>
  <SiteShell>
    <main class="lost">
      <p class="font-display text-8xl sm:text-9xl font-bold leading-none tracking-tighter text-hairline mb-4" aria-hidden="true">404</p>
      <p class="term-title">{labels.kicker}</p>
      <h1 class="pc-title">{labels.heading}</h1>
      <p class="pc-subtitle max-w-md">{labels.description}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href="/" class="pc-btn pc-btn-dark">{labels.back_home}</a>
        <a href="/plugins/" class="pc-btn pc-btn-light">{labels.search_plugins}</a>
        <a href="/projetos/" class="pc-btn pc-btn-light">{labels.search_projects}</a>
      </div>
    </main>
  </SiteShell>
</Layout>

<style>
  /* Centred in whatever height is left between the top bar and the footer.
     Type, colour and buttons all come from the shared paper theme. */
  .lost {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: 6rem;
    text-align: center;
  }
</style>

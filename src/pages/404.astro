---
import Layout from "../layouts/Layout.astro";
import SiteShell from "../components/SiteShell.astro";

const labels = {
  kicker: "Erro 404",
  heading: "Perdido no espaço?",
  description:
    "A página que você está procurando não existe ou foi movida para uma galáxia diferente.",
  back_home: "Voltar para Início",
  search_plugins: "Ver Plugins",
  search_projects: "Ver Projetos",
};
---

<Layout
  title="404 - Página não encontrada | Airton Vancin"
  description="A página que você está procurando não existe."
  lang="pt-BR"
  noindex
  noAds
  minimalNav={true}
  hideFooter={true}
>
  <SiteShell>
    <main class="lost">
      <p class="code" aria-hidden="true">404</p>
      <p class="kicker">{labels.kicker}</p>
      <h1>{labels.heading}</h1>
      <p class="desc">{labels.description}</p>
      <div class="actions">
        <a href="/" class="pc-btn pc-btn-dark">{labels.back_home}</a>
        <a href="/plugins/" class="pc-btn pc-btn-light">{labels.search_plugins}</a>
        <a href="/projetos/" class="pc-btn pc-btn-light">{labels.search_projects}</a>
      </div>
    </main>
  </SiteShell>
</Layout>

<style>
  .lost {
    position: relative;
    isolation: isolate;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 96px 0;
    text-align: center;
  }
  .lost::before {
    content: "";
    position: absolute;
    inset: 24px 3%;
    z-index: -1;
    background-image:
      linear-gradient(#5467d612 1px, transparent 1px),
      linear-gradient(90deg, #5467d612 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(#000 10%, #000c 46%, transparent 76%);
  }
  .code {
    margin: 0 0 8px;
    font-family: var(--pc-display);
    font-size: clamp(96px, 18vw, 180px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: #e4e4e0;
  }
  .kicker {
    margin: 0 0 10px;
    color: var(--pc-blue);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0 0 16px;
    font-weight: 700;
    font-size: clamp(30px, 4.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .desc {
    max-width: 520px;
    margin: 0;
    color: var(--pc-muted);
    font-size: 14px;
    line-height: 1.75;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { IconHome, IconSearch, IconArrowLeft } from "@tabler/icons-react";

const labels = {
  title: "404 - Página não encontrada",
  heading: "Perdido no espaço?",
  description:
    "A página que você está procurando não existe ou foi movida para uma galáxia diferente.",
  back_home: "Voltar para Início",
  search_plugins: "Ver Plugins",
  search_projects: "Ver Projetos",
};
---

<Layout
  title="404 - Página não encontrada | Airton Vancin"
  description="A página que você está procurando não existe."
  noindex
>
  <div
    class="min-h-[80vh] flex items-center justify-center p-4 relative overflow-hidden"
  >
    <!-- Abstract Background Decorations -->
    <div class="relative z-10 text-center max-w-2xl px-4">
      <!-- 404 Visual -->
      <div class="relative inline-block mb-8">
        <h1
          class="text-[12rem] md:text-[18rem] font-black leading-none tracking-tighter text-gallery-floor/80 dark:text-ink/50 select-none"
        >
          404
        </h1>
        <div class="absolute inset-0 flex items-center justify-center">
          <div
            class="bg-wall/80 dark:bg-ink/80 backdrop-blur-md px-6 py-2 rounded-2xl border border-hairline dark:border-ink-secondary shadow-xl"
          >
            <span
              class="text-2xl md:text-3xl font-bold text-ink dark:text-gallery-floor"
            >
              {labels.heading}
            </span>
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <p
        class="text-xl text-ink-secondary dark:text-quiet-faint mb-12 leading-relaxed font-serif italic"
      >
        {labels.description}
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <Button
          size="lg"
          className="rounded-full px-8 h-14 text-base font-bold shadow-lg shadow-blue-500/20 bg-brand hover:bg-brand-deep w-full sm:w-auto"
          asChild
        >
          <a href="/">
            <IconHome className="mr-2 h-5 w-5" />
            <span
              >{labels.back_home}</span
            >
          </a>
        </Button>

        <div class="flex gap-4 w-full sm:w-auto">
          <Button
            variant="outline"
            size="lg"
            className="rounded-full px-8 h-14 text-base font-bold border-hairline hover:bg-gallery-floor flex-1 sm:flex-none"
            asChild
          >
            <a href="/plugins">
              <span
                >{labels.search_plugins}</span
              >
            </a>
          </Button>

          <Button
            variant="outline"
            size="lg"
            className="rounded-full px-8 h-14 text-base font-bold border-hairline hover:bg-gallery-floor flex-1 sm:flex-none"
            asChild
          >
            <a href="/projetos">
              <span
                >{labels.search_projects}</span
              >
            </a>
          </Button>
        </div>
      </div>
    </div>
  </div>
</Layout>

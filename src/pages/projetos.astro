---
import MinimalPage from "../components/MinimalPage.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<MinimalPage
  title="Projects | Airton Vancin"
  description="Side projects by Airton Vancin: Declone, Lume IQ, Juros de Obra, Balancewise and more. Small, fast tools that solve one problem well."
  heading="Projects"
  subheading="Side projects, built in spare time"
>
  <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
    <p>
      Small, fast tools that each solve one problem well. Pick one to read how it was built,
      or visit the site from there.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="term-title"><span aria-hidden="true">~/</span>projects</h2>
    <ProjectGrid linkTo="case" />
  </section>
</MinimalPage>

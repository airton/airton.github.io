---
import Layout from "../layouts/Layout.astro";
import { previas, previaCategories } from "../data/previas";
import { Card, CardContent } from "@/components/ui/card";
import {
  IconLayoutGrid,
  IconArrowUpRight,
  IconSnowflake,
  IconSparkles,
  IconPaw,
  IconTool,
} from "@tabler/icons-react";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";

const title = {
  en: "Website Previews Portfolio - Airton Vancin",
  pt: "Portfólio de Prévias - Airton Vancin",
};

const description = {
  en: "A collection of live website previews built for local businesses across refrigeration, beauty, pet and B2B niches.",
  pt: "Uma coleção de prévias de sites publicadas para negócios locais nos nichos de refrigeração, beleza, pet e B2B.",
};

const labels = {
  eyebrow: { en: "Live Previews", pt: "Prévias ao Vivo" },
  title: {
    en: "Website previews built for real businesses.",
    pt: "Prévias de sites construídas para negócios reais.",
  },
  subtitle: {
    en: "Each link is a fully functional preview, delivered fast for local businesses to see their brand online before going live.",
    pt: "Cada link é uma prévia totalmente funcional, entregue com agilidade para o negócio ver sua marca no ar antes do lançamento.",
  },
  count: {
    en: `${previas.length} live previews`,
    pt: `${previas.length} prévias publicadas`,
  },
  visit: { en: "View preview", pt: "Ver prévia" },
};

const categoryIcons = {
  refrigeracao: IconSnowflake,
  beleza: IconSparkles,
  pet: IconPaw,
  b2b: IconTool,
} as const;

const grouped = previaCategories
  .map((cat) => ({
    ...cat,
    items: previas.filter((p) => p.category === cat.id),
  }))
  .filter((g) => g.items.length > 0);
---

<Layout title={title.pt} description={description.pt}>
  <section
    class="w-full py-24 md:py-32 bg-white flex justify-center min-h-screen"
  >
    <div class="container px-4 md:px-6 max-w-7xl">
      <!-- Header -->
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 text-left"
      >
        <div class="max-w-2xl">
          <div
            class="inline-flex items-center gap-2 text-indigo-600 font-medium text-sm tracking-wider uppercase mb-3 text-left"
          >
            <IconLayoutGrid className="w-4 h-4" />
            <span data-en={labels.eyebrow.en} data-pt={labels.eyebrow.pt}
              >{labels.eyebrow.pt}</span
            >
          </div>
          <h1
            class="text-4xl md:text-6xl font-bold tracking-tight text-slate-900 mb-6 leading-[1.1]"
            data-en={labels.title.en}
            data-pt={labels.title.pt}
          >
            {labels.title.pt}
          </h1>
          <p
            class="text-lg text-slate-500 font-serif italic text-left"
            data-en={labels.subtitle.en}
            data-pt={labels.subtitle.pt}
          >
            {labels.subtitle.pt}
          </p>
        </div>
        <div class="hidden md:block">
          <p
            class="text-slate-500 text-sm max-w-[200px] text-right font-bold uppercase tracking-widest"
            data-en={labels.count.en}
            data-pt={labels.count.pt}
          >
            {labels.count.pt}
          </p>
        </div>
      </div>

      <!-- Grouped previews -->
      <div class="flex flex-col gap-16">
        {
          grouped.map((group) => {
            const CatIcon = categoryIcons[group.id];
            return (
              <div>
                <div class="flex items-center gap-3 mb-8">
                  <div class="p-2.5 bg-indigo-50 rounded-2xl text-indigo-600">
                    <CatIcon className="w-5 h-5" />
                  </div>
                  <h2
                    class="text-2xl font-bold tracking-tight text-slate-900"
                    data-en={group.labelEn}
                    data-pt={group.labelPt}
                  >
                    {group.labelPt}
                  </h2>
                  <span class="text-sm font-bold text-slate-600 tabular-nums">
                    {String(group.items.length).padStart(2, "0")}
                  </span>
                  <div class="h-px flex-grow bg-slate-100 ml-2" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {group.items.map((previa) => (
                    <a
                      href={previa.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group block h-full"
                    >
                      <Card className="h-full bg-white border border-slate-100 shadow-[0_2px_15px_-3px_rgba(0,0,0,0.04)] hover:shadow-[0_20px_40px_-12px_rgba(0,0,0,0.12)] group-hover:-translate-y-1 group-hover:border-indigo-100 transition-all duration-500 rounded-3xl overflow-hidden flex flex-col">
                        <CardContent className="p-7 flex-grow flex flex-col">
                          <div class="flex items-start justify-between gap-4 mb-6">
                            <h3 class="text-xl font-bold text-slate-900 group-hover:text-indigo-600 transition-colors duration-300 leading-snug">
                              {previa.name}
                            </h3>
                            <div class="shrink-0 p-2 bg-slate-50 rounded-full text-slate-500 group-hover:bg-indigo-50 group-hover:text-indigo-600 transition-all duration-300">
                              <IconArrowUpRight className="w-5 h-5 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300" />
                            </div>
                          </div>

                          <div class="mt-auto flex flex-col gap-1">
                            <span class="text-sm font-medium text-slate-600">
                              {previa.niche}
                            </span>
                            {previa.location && (
                              <span class="text-xs text-slate-500 uppercase tracking-wider">
                                {previa.location}
                              </span>
                            )}
                          </div>
                        </CardContent>
                      </Card>
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
  <LanguageSwitcher />
</Layout>

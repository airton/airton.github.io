---
/*
  Live site previews built for local businesses, grouped by niche. The audience
  is Brazilian business owners, so the page and its chrome are Portuguese.
*/
import MinimalPage from "@/components/MinimalPage.astro";
import { previas, previaCategories } from "@/data/previas";

const grouped = previaCategories
  .map((cat) => ({ ...cat, items: previas.filter((p) => p.category === cat.id) }))
  .filter((g) => g.items.length > 0);
---

<MinimalPage
  title="Portfólio de Prévias | Airton Vancin"
  description="Uma coleção de prévias de sites publicadas para negócios locais nos nichos de refrigeração, beleza, pet e B2B."
  heading="Prévias"
  subheading={`${previas.length} prévias publicadas`}
  lang="pt-BR"
  backLabel="← Início"
>
  <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
    <p>
      Prévias de sites construídas para negócios reais. Cada link é uma prévia funcionando, entregue com
      agilidade para o negócio ver sua marca no ar antes do lançamento.
    </p>
  </section>

  {
    grouped.map((group) => (
      <section class="mb-14">
        <div class="flex items-baseline gap-2 mb-4">
          <h2 class="term-title mb-0"><span aria-hidden="true">~/</span>{group.id}</h2>
          <span class="text-xs text-quiet dark:text-quiet-lifted">{group.labelPt} · {group.items.length}</span>
        </div>
        <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
          {group.items.map((previa) => (
            <li>
              <a
                href={previa.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-baseline justify-between gap-4 py-2.5"
              >
                <span class="text-base group-hover:underline underline-offset-4">
                  {previa.name}
                  <span aria-hidden="true" class="text-quiet-faint dark:text-quiet">↗</span>
                </span>
                <span class="shrink-0 text-right text-xs text-quiet dark:text-quiet-lifted">
                  {previa.niche}
                  {previa.location && <span class="hidden sm:inline"> · {previa.location}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</MinimalPage>

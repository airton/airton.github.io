---
import Layout from "@/layouts/Layout.astro";
import GeminiDownloader from "@/components/GeminiDownloader.astro";
import SiteShell from "@/components/SiteShell.astro";
import { geminiJsonLd, GEMINI_ALTERNATES } from "@/helpers/geminiSeo";

const SEO_TITLE =
  "Download em Massa de Imagens do Gemini Flow — Extensão Chrome (.zip)";
const SEO_DESC =
  "Extensão gratuita para Chrome que baixa em massa todas as imagens geradas no Google Gemini / Flow em um clique, empacotadas em um único arquivo .zip.";
const OG_IMAGE = new URL(
  "/assets/images/gemini-flow-downloader-og.png",
  Astro.site
).toString();
---

<Layout
  title={SEO_TITLE}
  description={SEO_DESC}
  image={OG_IMAGE}
  lang="pt-BR"
  alternates={GEMINI_ALTERNATES}
  minimalNav={true}
  hideFooter={true}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(
      geminiJsonLd({
        lang: "pt",
        description: SEO_DESC,
        image: OG_IMAGE,
        site: Astro.site!,
      })
    )}
  />
  <SiteShell>
    <GeminiDownloader lang="pt" />
  </SiteShell>
</Layout>

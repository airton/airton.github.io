---
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "../components/MinimalFooter.astro";
import { Image } from "astro:assets";
import avatar from "../assets/images/profile-avatar.png";
import { breadcrumbJsonLd, PERSON_ID } from "@/helpers/siteIdentity";

const site = Astro.site || new URL("https://airtonvancin.com");
const pageUrl = new URL(Astro.url.pathname, site).toString();

/*
  This is the page the Person node points its `url` at, so it declares itself
  the profile page for that entity rather than minting a second Person. The
  identity itself lives in helpers/siteIdentity.ts and is emitted by Layout.
*/
const profileJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${pageUrl}#profilepage`,
  url: pageUrl,
  inLanguage: "en",
  mainEntity: { "@id": new URL(PERSON_ID, site).toString() },
};

const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Home", path: "/" },
    { name: "About", path: "/sobre/" },
  ],
  site,
  pageUrl,
);

const stack = [
  { area: "AI & automation", tools: "LLM apps, agents, workflow automation" },
  { area: "Front-end", tools: "React, Next.js, TypeScript, Tailwind CSS, Astro" },
  { area: "Back-end", tools: "Node.js, Express, PHP, WordPress, REST APIs" },
  { area: "Data", tools: "PostgreSQL, MySQL, MongoDB, Supabase, Firebase" },
  { area: "Cloud & DevOps", tools: "AWS, Docker, CI/CD, GitHub Actions, Vercel" },
];

const experience = [
  {
    when: "Now",
    role: "Engineering Director, AI",
    note: "Leading engineering for AI products.",
  },
  {
    when: "2018",
    role: "Senior Software Engineer",
    note: "Complex web applications, technical leadership and scalable architectures.",
  },
  {
    when: "2014",
    role: "WordPress Developer",
    note: "Custom themes and plugins, performance and SEO.",
  },
];

const education = [
  {
    title: "Information Systems",
    note: "Bachelor's degree in software development, databases and systems architecture.",
  },
  {
    title: "AWS certifications",
    note: "Solutions architecture and cloud development on AWS.",
  },
];

const socialLinks = [
  { href: "https://github.com/airton", label: "GitHub" },
  { href: "https://linkedin.com/in/airtonvancin", label: "LinkedIn" },
  { href: "https://x.com/a_vancin", label: "X" },
  { href: "https://profiles.wordpress.org/airtonvancin/", label: "WordPress" },
];
---

<Layout
  title="About | Airton Vancin"
  description="About Airton Vancin: Engineering Director in AI with 15+ years in software engineering, building side projects across React, Node.js, WordPress and AWS."
  lang="en"
  minimalNav={true}
  hideFooter={true}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profileJsonLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />

  <main class="font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <a href="/" class="text-sm text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors">
      ← Home
    </a>

    <!-- Header -->
    <header class="mt-10 mb-14 flex items-center gap-4">
      <Image
        src={avatar}
        alt="Airton Vancin"
        width={112}
        height={112}
        loading="eager"
        class="w-14 h-14 rounded-full object-cover"
      />
      <div>
        <h1 class="font-plex text-xl font-semibold tracking-tight">About</h1>
        <p class="text-sm text-quiet dark:text-quiet-lifted">Airton Vancin · AI Engineer & Builder</p>
      </div>
    </header>

    <!-- Intro -->
    <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
      <p>
        I'm Airton. I work as an Engineering Director in AI, after more than 15 years writing
        software — from WordPress themes and plugins to React front-ends, Node.js back-ends and
        AWS infrastructure.
      </p>
      <p>
        In my spare time I build side projects: small, fast tools that solve one problem well.
        Some of them are on the <a href="/" class="quiet-link">home page</a>, and I write about
        what I learn on the <a href="/blog/" class="quiet-link">blog</a>.
      </p>
    </section>

    <!-- Stack -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>stack</h2>
      <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
        {
          stack.map((s) => (
            <div class="grid sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-0.5 py-2.5">
              <dt class="font-medium">{s.area}</dt>
              <dd class="text-quiet dark:text-quiet-lifted">{s.tools}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Experience -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>experience</h2>
      <ol class="divide-y divide-hairline-faint dark:divide-night-edge">
        {
          experience.map((e) => (
            <li class="grid grid-cols-[4rem_1fr] gap-x-4 py-3">
              <span class="font-mono text-xs text-quiet dark:text-quiet-lifted pt-1">{e.when}</span>
              <div>
                <p class="font-medium">{e.role}</p>
                <p class="text-sm text-quiet dark:text-quiet-lifted mt-0.5">{e.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Education -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>education</h2>
      <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
        {
          education.map((e) => (
            <li class="py-3">
              <p class="font-medium">{e.title}</p>
              <p class="text-sm text-quiet dark:text-quiet-lifted mt-0.5">{e.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Elsewhere -->
    <section class="mb-16">
      <h2 class="term-title"><span aria-hidden="true">~/</span>elsewhere</h2>
      <p class="text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
        {
          socialLinks.map((s, i) => (
            <>
              <a href={s.href} target="_blank" rel="me noopener noreferrer" class="quiet-link">{s.label}</a>
              {i < socialLinks.length - 1 && <span class="text-quiet-faint"> · </span>}
            </>
          ))
        }
        <br />
        Open to projects, partnerships and consulting — <a href="/contato/" class="quiet-link">get in touch</a>
        or email <a href="mailto:airtonvancin@gmail.com" class="quiet-link">airtonvancin@gmail.com</a>.
      </p>
    </section>

    <MinimalFooter />
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import avatar from "../assets/images/profile-avatar.png";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconMail,
  IconCode,
  IconServer,
  IconDatabase,
  IconCloud,
  IconBriefcase,
  IconSchool,
  IconNews,
} from "@tabler/icons-react";
---

<Layout
  title="Sobre Mim | Airton Vancin"
  description="Conheça Airton Vancin, Software Engineer com experiência em React, Node.js, TypeScript e arquitetura de software."
>
  <!-- Hero Section -->
  <section
    class="w-full py-16 md:py-24 lg:py-32 bg-gallery-floor flex justify-center"
  >
    <div class="container px-4 md:px-6 max-w-5xl">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <!-- Avatar -->
        <div class="flex-shrink-0">
          <div
            class="w-40 h-40 md:w-52 md:h-52 rounded-full bg-hairline p-px"
          >
            <Image
              src={avatar}
              alt="Airton Vancin"
              width={416}
              height={416}
              format="avif"
              quality={80}
              loading="eager"
              class="w-full h-full rounded-full object-cover"
            />
          </div>
        </div>

        <!-- Intro -->
        <div class="text-center md:text-left">
          <h1
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-ink mb-4"
          >
            Olá, eu sou Airton Vancin
          </h1>
          <p class="text-xl text-ink-secondary mb-6 max-w-2xl">
            Software Engineer apaixonado por criar soluções web modernas,
            escaláveis e de alta performance. Com mais de 15 anos de experiência
            em desenvolvimento de software.
          </p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start">
            <a href="https://github.com/airton" target="_blank">
              <Button variant="outline" className="gap-2">
                <IconBrandGithub className="w-4 h-4" />
                GitHub
              </Button>
            </a>
            <a href="https://linkedin.com/in/airtonvancin" target="_blank">
              <Button variant="outline" className="gap-2">
                <IconBrandLinkedin className="w-4 h-4" />
                LinkedIn
              </Button>
            </a>
            <a
              href="https://nichesignal.substack.com/?utm_campaign=airtonvancin.com"
              target="_blank"
            >
              <Button variant="outline" className="gap-2">
                <IconNews className="w-4 h-4" />
                Substack
              </Button>
            </a>
            <a href="mailto:airtonvancin@gmail.com">
              <Button className="gap-2 bg-brand hover:bg-brand-deep">
                <IconMail className="w-4 h-4" />
                Contato
              </Button>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="w-full py-16 md:py-24 bg-wall flex justify-center">
    <div class="container px-4 md:px-6 max-w-5xl">
      <h2 class="text-3xl font-bold text-ink mb-8 text-center">
        Minhas Especialidades
      </h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <Card className="border-hairline hover:shadow-lg transition-shadow">
          <CardContent className="p-6 text-center">
            <IconCode className="w-12 h-12 text-ink mx-auto mb-4" />
            <h3 class="font-semibold text-lg text-ink mb-2">Front-end</h3>
            <p class="text-sm text-ink-secondary">
              React, Next.js, TypeScript, Tailwind CSS, Astro
            </p>
          </CardContent>
        </Card>

        <Card className="border-hairline hover:shadow-lg transition-shadow">
          <CardContent className="p-6 text-center">
            <IconServer className="w-12 h-12 text-ink mx-auto mb-4" />
            <h3 class="font-semibold text-lg text-ink mb-2">Back-end</h3>
            <p class="text-sm text-ink-secondary">
              Node.js, Express, PHP, WordPress, APIs REST
            </p>
          </CardContent>
        </Card>

        <Card className="border-hairline hover:shadow-lg transition-shadow">
          <CardContent className="p-6 text-center">
            <IconDatabase className="w-12 h-12 text-ink mx-auto mb-4" />
            <h3 class="font-semibold text-lg text-ink mb-2">
              Banco de Dados
            </h3>
            <p class="text-sm text-ink-secondary">
              PostgreSQL, MySQL, MongoDB, Supabase, Firebase
            </p>
          </CardContent>
        </Card>

        <Card className="border-hairline hover:shadow-lg transition-shadow">
          <CardContent className="p-6 text-center">
            <IconCloud className="w-12 h-12 text-ink mx-auto mb-4" />
            <h3 class="font-semibold text-lg text-ink mb-2">
              Cloud & DevOps
            </h3>
            <p class="text-sm text-ink-secondary">
              AWS, Docker, CI/CD, GitHub Actions, Vercel
            </p>
          </CardContent>
        </Card>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section class="w-full py-16 md:py-24 bg-gallery-floor flex justify-center">
    <div class="container px-4 md:px-6 max-w-5xl">
      <h2 class="text-3xl font-bold text-ink mb-8 text-center">
        Experiência & Formação
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Experience -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <IconBriefcase className="w-6 h-6 text-brand" />
            <h3 class="text-xl font-semibold text-ink">Experiência</h3>
          </div>

          <div class="space-y-6">
            <Card className="border-hairline">
              <CardContent className="p-4">
                <h4 class="font-semibold text-ink">
                  Software Engineer Senior
                </h4>
                <p class="text-sm text-quiet mb-2">2018 - Presente</p>
                <p class="text-ink-secondary text-sm">
                  Desenvolvimento de aplicações web complexas, liderança técnica
                  e implementação de arquiteturas escaláveis.
                </p>
              </CardContent>
            </Card>

            <Card className="border-hairline">
              <CardContent className="p-4">
                <h4 class="font-semibold text-ink">
                  Desenvolvedor WordPress
                </h4>
                <p class="text-sm text-quiet mb-2">2014 - 2018</p>
                <p class="text-ink-secondary text-sm">
                  Criação de temas e plugins personalizados para WordPress,
                  otimização de performance e SEO.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>

        <!-- Education -->
        <div>
          <div class="flex items-center gap-3 mb-6">
            <IconSchool className="w-6 h-6 text-brand" />
            <h3 class="text-xl font-semibold text-ink">Formação</h3>
          </div>

          <div class="space-y-6">
            <Card className="border-hairline">
              <CardContent className="p-4">
                <h4 class="font-semibold text-ink">
                  Análise e Desenvolvimento de Sistemas
                </h4>
                <p class="text-sm text-quiet mb-2">Graduação</p>
                <p class="text-ink-secondary text-sm">
                  Formação técnica em desenvolvimento de software, banco de
                  dados e arquitetura de sistemas.
                </p>
              </CardContent>
            </Card>

            <Card className="border-hairline">
              <CardContent className="p-4">
                <h4 class="font-semibold text-ink">Certificações AWS</h4>
                <p class="text-sm text-quiet mb-2">Cloud Computing</p>
                <p class="text-ink-secondary text-sm">
                  Certificações em arquitetura de soluções e desenvolvimento na
                  nuvem AWS.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="w-full py-16 md:py-24 bg-ink flex justify-center">
    <div class="container px-4 md:px-6 max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-wall mb-4">
        Vamos trabalhar juntos?
      </h2>
      <p class="text-quiet-lifted mb-8 text-lg">
        Estou sempre aberto a novos projetos e oportunidades. Entre em contato
        para discutirmos como posso ajudar.
      </p>
      <a href="/contato">
        <Button size="lg" className="bg-brand hover:bg-brand-deep text-wall">
          Entre em Contato
        </Button>
      </a>
    </div>
  </section>
</Layout>

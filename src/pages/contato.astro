---
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  IconMail,
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandTwitter,
  IconMapPin,
  IconClock,
  IconNews,
} from "@tabler/icons-react";
---

<Layout
  title="Contato | Airton Vancin"
  description="Entre em contato comigo para discutir projetos, oportunidades ou tirar dúvidas sobre desenvolvimento web."
>
  <!-- Hero Section -->
  <section
    class="w-full py-16 md:py-24 lg:py-32 bg-gallery-floor border-b border-hairline flex justify-center"
  >
    <div class="container px-4 md:px-6 max-w-4xl text-center">
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-ink mb-4">
        Entre em Contato
      </h1>
      <p class="text-xl text-quiet max-w-2xl mx-auto">
        Tem um projeto em mente ou quer conversar sobre tecnologia? Estou sempre
        aberto a novas oportunidades e parcerias.
      </p>
    </div>
  </section>

  <!-- Contact Info Section -->
  <section class="w-full py-16 md:py-24 bg-wall flex justify-center">
    <div class="container px-4 md:px-6 max-w-5xl">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Methods -->
        <div>
          <h2 class="text-2xl font-bold text-ink mb-6">
            Como me encontrar
          </h2>

          <div class="space-y-6">
            <Card
              className="border-hairline hover:shadow-md transition-shadow"
            >
              <CardContent className="p-6 flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-brand-wash rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <IconMail className="w-6 h-6 text-brand" />
                </div>
                <div>
                  <h3 class="font-semibold text-ink mb-1">E-mail</h3>
                  <a
                    href="mailto:airtonvancin@gmail.com"
                    class="text-brand hover:underline"
                  >
                    airtonvancin@gmail.com
                  </a>
                  <p class="text-sm text-quiet mt-1">
                    Respondo em até 24 horas
                  </p>
                </div>
              </CardContent>
            </Card>

            <Card
              className="border-hairline hover:shadow-md transition-shadow"
            >
              <CardContent className="p-6 flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-hairline-faint rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <IconBrandLinkedin className="w-6 h-6 text-ink-secondary" />
                </div>
                <div>
                  <h3 class="font-semibold text-ink mb-1">LinkedIn</h3>
                  <a
                    href="https://linkedin.com/in/airtonvancin"
                    target="_blank"
                    class="text-brand hover:underline"
                  >
                    linkedin.com/in/airtonvancin
                  </a>
                  <p class="text-sm text-quiet mt-1">
                    Conecte-se para networking profissional
                  </p>
                </div>
              </CardContent>
            </Card>

            <Card
              className="border-hairline hover:shadow-md transition-shadow"
            >
              <CardContent className="p-6 flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-hairline-faint rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <IconBrandGithub className="w-6 h-6 text-ink-secondary" />
                </div>
                <div>
                  <h3 class="font-semibold text-ink mb-1">GitHub</h3>
                  <a
                    href="https://github.com/airton"
                    target="_blank"
                    class="text-brand hover:underline"
                  >
                    github.com/airton
                  </a>
                  <p class="text-sm text-quiet mt-1">
                    Confira meus projetos open source
                  </p>
                </div>
              </CardContent>
            </Card>

            <Card
              className="border-hairline hover:shadow-md transition-shadow"
            >
              <CardContent className="p-6 flex items-start gap-4">
                <div
                  class="w-12 h-12 bg-hairline-faint rounded-xl flex items-center justify-center flex-shrink-0"
                >
                  <IconNews className="w-6 h-6 text-ink-secondary" />
                </div>
                <div>
                  <h3 class="font-semibold text-ink mb-1">Newsletter</h3>
                  <a
                    href="https://nichesignal.substack.com/?utm_campaign=airtonvancin.com"
                    target="_blank"
                    class="text-brand hover:underline"
                  >
                    nichesignal.substack.com
                  </a>
                  <p class="text-sm text-quiet mt-1">
                    Assine minha newsletter sobre tecnologia
                  </p>
                </div>
              </CardContent>
            </Card>
          </div>
        </div>

        <!-- Additional Info -->
        <div>
          <h2 class="text-2xl font-bold text-ink mb-6">
            Informações Adicionais
          </h2>

          <Card className="border-hairline mb-6">
            <CardContent className="p-6">
              <div class="flex items-start gap-4 mb-4">
                <IconMapPin
                  className="w-5 h-5 text-quiet flex-shrink-0 mt-1"
                />
                <div>
                  <h3 class="font-semibold text-ink">Localização</h3>
                  <p class="text-ink-secondary">Brasil</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <IconClock
                  className="w-5 h-5 text-quiet flex-shrink-0 mt-1"
                />
                <div>
                  <h3 class="font-semibold text-ink">
                    Horário de Resposta
                  </h3>
                  <p class="text-ink-secondary">Segunda a Sexta, 9h às 18h (BRT)</p>
                </div>
              </div>
            </CardContent>
          </Card>

          <Card className="border-brand-edge bg-brand-wash">
            <CardContent className="p-6">
              <h3 class="font-semibold text-ink mb-3">
                O que posso ajudar?
              </h3>
              <ul class="space-y-2 text-ink-secondary">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
                  Desenvolvimento de aplicações web
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
                  Consultoria em arquitetura de software
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
                  Plugins e temas WordPress
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
                  Migração para cloud (AWS)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 bg-brand rounded-full"></span>
                  Mentoria em desenvolvimento
                </li>
              </ul>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="w-full py-16 bg-hairline-faint flex justify-center">
    <div class="container px-4 md:px-6 max-w-3xl text-center">
      <h2 class="text-2xl font-bold text-ink mb-4">
        Prefere enviar um e-mail diretamente?
      </h2>
      <p class="text-ink-secondary mb-6">
        Clique no botão abaixo para abrir seu cliente de e-mail com meu endereço
        já preenchido.
      </p>
      <a href="mailto:airtonvancin@gmail.com?subject=Contato%20via%20Site">
        <Button size="lg" className="bg-brand hover:bg-brand-deep text-wall">
          <IconMail className="w-5 h-5 mr-2" />
          Enviar E-mail
        </Button>
      </a>
    </div>
  </section>
</Layout>

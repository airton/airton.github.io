---
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "../components/MinimalFooter.astro";

const body = "space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";

const channels = [
  { label: "Email", href: "mailto:airtonvancin@gmail.com?subject=Hello%20from%20your%20site", text: "airtonvancin@gmail.com", note: "Best way to reach me" },
  { label: "LinkedIn", href: "https://linkedin.com/in/airtonvancin", text: "in/airtonvancin", note: "Professional network" },
  { label: "X", href: "https://x.com/a_vancin", text: "@a_vancin", note: "What I'm building, as I build it" },
  { label: "GitHub", href: "https://github.com/airton", text: "airton", note: "Code and open source" },
];

const topics = [
  "Web application development",
  "Software architecture consulting",
  "WordPress plugins and themes",
  "Cloud migration on AWS",
  "Mentoring developers",
];
---

<Layout
  title="Contact | Airton Vancin"
  description="Get in touch with Airton Vancin about projects, partnerships, consulting or mentoring. Email, LinkedIn, X and GitHub."
  lang="en"
  image="/og-home.png"
  minimalNav={true}
  hideFooter={true}
>
  <main class="font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <a href="/" class="text-sm text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors">
      ← Home
    </a>

    <header class="mt-10 mb-14">
      <h1 class="font-plex text-xl font-semibold tracking-tight">Contact</h1>
      <p class="text-sm text-quiet dark:text-quiet-lifted">Brazil · I usually reply within 24 hours on weekdays</p>
    </header>

    <section class={`mb-14 ${body}`}>
      <p>
        Have a project in mind or want to talk about software and AI? I'm open to projects,
        partnerships and consulting. Email is the fastest way to reach me.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>channels</h2>
      <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
        {
          channels.map((c) => (
            <div class="grid grid-cols-[6rem_1fr] sm:grid-cols-[8rem_1fr] gap-x-4 py-2.5">
              <dt class="font-medium">{c.label}</dt>
              <dd>
                <a
                  href={c.href}
                  class="quiet-link"
                  {...(c.href.startsWith("http") ? { target: "_blank", rel: "me noopener noreferrer" } : {})}
                >
                  {c.text}
                </a>
                <span class="block text-sm text-quiet dark:text-quiet-lifted">{c.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mb-16">
      <h2 class="term-title"><span aria-hidden="true">~/</span>i-can-help-with</h2>
      <ul class={`list-disc pl-5 ${body} space-y-1.5`}>
        {topics.map((t) => <li>{t}</li>)}
      </ul>
    </section>

    <MinimalFooter />
  </main>
</Layout>

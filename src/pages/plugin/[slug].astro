---
/*
  Portuguese plugin page. The URL is unchanged from before the language split —
  it is the one Google has indexed and the one carrying the site's search
  impressions, so it keeps its path and the English version takes /en/.
*/
import PluginArticle from "@/components/PluginArticle.astro";
import { plugins } from "@/data/plugins";

export async function getStaticPaths() {
  return plugins.map((plugin) => ({
    params: { slug: plugin.slug },
    props: { plugin },
  }));
}

const { plugin } = Astro.props;

---

<PluginArticle plugin={plugin} lang="pt" />

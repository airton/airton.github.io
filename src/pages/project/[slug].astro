---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  IconArrowLeft,
  IconExternalLink,
  IconCircleCheck,
  IconQuestionMark,
  IconLayersIntersect,
} from "@tabler/icons-react";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout
  title={`${project.name} - Case Study | Airton Vancin`}
  description={project.desc}
  image={project.image.src}
>
  <div class="bg-wall border-b border-hairline-faint">
    <div class="container px-4 md:px-6 py-12 md:py-20 max-w-6xl mx-auto">
      <a
        href="/#projects"
        class="inline-flex items-center text-sm font-medium text-quiet hover:text-brand mb-12 transition-colors group"
      >
        <IconArrowLeft
          className="mr-2 h-4 w-4 transform group-hover:-translate-x-1 transition-transform"
        />
        Voltar para projetos
      </a>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <div
            class="inline-flex items-center gap-2 bg-brand-wash text-brand px-3 py-1 rounded-full text-xs font-bold tracking-widest uppercase"
          >
            <IconLayersIntersect className="w-3.5 h-3.5" />
            Projeto em Destaque
          </div>

          <div class="space-y-4">
            <h1
              class="text-4xl md:text-6xl font-bold tracking-tight text-ink leading-[1.1]"
            >
              {project.name}
            </h1>
            <p class="text-xl text-ink-secondary leading-relaxed font-serif italic">
              {project.desc}
            </p>
          </div>

          <div class="flex flex-wrap gap-4 pt-4">
            <Button
              size="lg"
              className="rounded-full px-8 h-14 text-base font-bold shadow-lg shadow-brand-bright/20 bg-brand hover:bg-brand-deep"
              asChild
            >
              <a href={project.link} target="_blank" rel="noopener noreferrer">
                Visitar Projeto <IconExternalLink className="ml-2 h-5 w-5" />
              </a>
            </Button>
            {
              project.technologies &&
                project.technologies
                  .slice(0, 3)
                  .map((tech) => (
                    <div class="hidden sm:flex items-center px-5 py-2 bg-gallery-floor border border-hairline-faint rounded-full text-sm text-quiet font-bold tracking-tight uppercase">
                      {tech}
                    </div>
                  ))
            }
          </div>
        </div>

        <div class="relative group">
          <div
            class="relative overflow-hidden rounded-[2.5rem] border border-hairline-faint shadow-2xl transition-all duration-700 group-hover:scale-[1.02]"
          >
            <Image
              src={project.image}
              alt={project.name}
              class="w-full aspect-[4/3] object-cover grayscale transition-all duration-1000 group-hover:grayscale-0"
              width={1200}
              height={900}
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container px-4 md:px-6 py-24 max-w-4xl mx-auto">
    <div class="grid gap-24">
      <!-- Description -->
      <section
        class="prose prose-slate lg:prose-lg max-w-none prose-headings:text-ink prose-p:text-ink-secondary prose-p:leading-relaxed prose-li:text-ink-secondary prose-strong:text-ink"
      >
        <div set:html={project.fullDescription} />
      </section>

      <!-- Technologies -->
      {
        project.technologies && project.technologies.length > 0 && (
          <section>
            <div class="flex items-center gap-4 mb-10">
              <h2 class="text-3xl font-bold text-ink">Tecnologias</h2>
              <div class="h-px flex-grow bg-hairline-faint" />
            </div>
            <div class="flex flex-wrap gap-3">
              {project.technologies.map((tech) => (
                <div class="px-6 py-3 bg-wall border border-hairline-faint rounded-2xl text-sm font-bold text-ink-secondary shadow-sm hover:border-brand-edge hover:text-brand transition-all cursor-default">
                  {tech}
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Features -->
      <section>
        <div class="flex items-center gap-4 mb-10">
          <h2 class="text-3xl font-bold text-ink">Principais Recursos</h2>
          <div class="h-px flex-grow bg-hairline-faint"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-6">
          {
            project.features.map((feature) => (
              <div class="group p-8 bg-wall border border-hairline-faint rounded-[2rem] shadow-sm hover:shadow-md hover:border-brand-edge transition-all flex items-start gap-5">
                <div class="p-3 bg-brand-wash rounded-2xl text-brand-bright group-hover:bg-brand group-hover:text-wall transition-colors duration-300">
                  <IconCircleCheck className="w-6 h-6" />
                </div>
                <span class="text-ink-secondary font-semibold leading-relaxed pt-1">
                  {feature}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <!-- FAQ -->
      {
        project.faq && project.faq.length > 0 && (
          <section>
            <div class="flex items-center gap-4 mb-10">
              <h2 class="text-3xl font-bold text-ink">
                Perguntas Frequentes
              </h2>
              <div class="h-px flex-grow bg-hairline-faint" />
            </div>
            <div class="grid gap-8">
              {project.faq.map((item) => (
                <div class="bg-gallery-floor border border-transparent p-10 rounded-[2.5rem] hover:bg-wall hover:border-hairline-faint transition-all duration-300 shadow-sm group">
                  <div class="flex items-start gap-5 mb-6">
                    <div class="w-12 h-12 shrink-0 bg-wall shadow-sm flex items-center justify-center rounded-2xl text-quiet group-hover:text-brand-bright transition-colors">
                      <IconQuestionMark className="w-6 h-6" />
                    </div>
                    <h3 class="text-2xl font-bold text-ink pt-2 tracking-tight group-hover:text-brand">
                      {item.question}
                    </h3>
                  </div>
                  <p class="text-lg text-quiet leading-relaxed ml-16">
                    {item.answer}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>
</Layout>

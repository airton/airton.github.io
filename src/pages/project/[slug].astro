---
/*
  One project's case study, on the minimal shell. The copy in data/projects.ts
  is Portuguese, so the page declares pt-BR; the `~/section` labels are the
  same English identifiers used across the minimal pages.
*/
import { Image } from "astro:assets";
import MinimalPage from "@/components/MinimalPage.astro";
import { projects, BUILDING } from "@/data/projects";
import { breadcrumbJsonLd } from "@/helpers/siteIdentity";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const host = hostOf(project.link);
const body = "text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";

/*
  `image` is each site's social card, shown at its own aspect so nothing is
  cropped. Declone's is a 320px square icon rather than a card, and blown up to
  the column width it read as a giant logo; anything that small is skipped.
*/
const showCard = project.image.width >= 600;

const others = projects.filter((p) => p.slug !== project.slug);

const site = Astro.site ?? new URL("https://airtonvancin.com");
const pageUrl = new URL(Astro.url.pathname, site).href;
const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Home", path: "/" },
    { name: "Projects", path: "/projetos/" },
    { name: project.name, path: Astro.url.pathname },
  ],
  site,
  pageUrl,
);
// Same `#faq` binding as ArticleLayout: the bare URL belongs to the page itself.
const faqJsonLd = project.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      inLanguage: "pt-BR",
      mainEntity: project.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : undefined;
---

<MinimalPage
  title={`${project.name} - Case Study | Airton Vancin`}
  description={project.desc}
  heading={project.name}
  lang="pt-BR"
  image={project.image.src}
  backLabel="← Projects"
  backHref="/projetos/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <Image
    slot="icon"
    src={project.logo}
    alt=""
    width={80}
    height={80}
    class="w-10 h-10 rounded-lg object-cover border border-hairline-faint dark:border-night-edge shrink-0"
  />

  <p slot="subheading" class="flex items-center gap-2">
    <a
      href={project.link}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-xs text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor"
    >
      {host}
    </a>
    {
      BUILDING.has(project.slug) && (
        <span
          class="text-xs px-1.5 py-px rounded bg-status-ground text-status-ink dark:bg-night-edge dark:text-live-signal"
          lang="en"
        >
          building
        </span>
      )
    }
  </p>

  <Fragment slot="header">
    <p class={`mt-6 ${body}`}>{project.desc}</p>
    <p class="mt-4 text-sm">
      <a href={project.link} target="_blank" rel="noopener noreferrer" class="quiet-link">Visitar {host} →</a>
    </p>
  </Fragment>

  {
    showCard && (
      <a href={project.link} target="_blank" rel="noopener noreferrer" class="block mb-14" tabindex="-1" aria-hidden="true">
        <Image
          src={project.image}
          alt=""
          width={1200}
          class="w-full h-auto rounded-md border border-hairline-faint dark:border-night-edge"
        />
      </a>
    )
  }

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>about</h2>
    <div class="prose post-body" set:html={project.fullDescription} />
  </section>

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>features</h2>
    <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
      {project.features.map((feature) => <li class={`py-2.5 ${body}`}>{feature}</li>)}
    </ul>
  </section>

  {
    project.technologies?.length > 0 && (
      <section class="mb-14">
        <h2 class="term-title"><span aria-hidden="true">~/</span>stack</h2>
        <ul class="flex flex-wrap gap-2">
          {project.technologies.map((tech) => (
            <li class="font-mono text-xs px-2 py-1 rounded border border-hairline-faint text-ink-secondary dark:border-night-edge dark:text-quiet-lifted">
              {tech}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    project.faq?.length > 0 && (
      <section id="faq" class="mb-14">
        <h2 class="term-title"><span aria-hidden="true">~/</span>faq</h2>
        <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
          {project.faq.map((item) => (
            <div class="py-4">
              <dt class="font-medium">{item.question}</dt>
              <dd class={`mt-1 ${body}`}>{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="mb-14" lang="en">
    <h2 class="term-title"><span aria-hidden="true">~/</span>more-projects</h2>
    <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
      {
        others.map((p) => (
          <li>
            <a href={`/project/${p.slug}/`} class="group flex items-center gap-3 py-2.5">
              <Image src={p.logo} alt="" width={48} height={48} class="w-6 h-6 rounded object-cover shrink-0" />
              <span class="text-base group-hover:underline underline-offset-4">{p.name}</span>
              <span class="ml-auto font-mono text-xs text-quiet dark:text-quiet-lifted">{hostOf(p.link)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</MinimalPage>

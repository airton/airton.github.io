---
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "../components/MinimalFooter.astro";

const body = "space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";
---

<Layout
  title="Terms of Use | Airton Vancin"
  description="The rules for using the content on airtonvancin.com: license, disclaimer, limitations, accuracy and external links."
  lang="en"
  image="/og-home.png"
  minimalNav={true}
  hideFooter={true}
>
  <main class="font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <a href="/" class="text-sm text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors">
      ← Home
    </a>

    <header class="mt-10 mb-14">
      <h1 class="font-plex text-xl font-semibold tracking-tight">Terms of Use</h1>
      <p class="text-sm text-quiet dark:text-quiet-lifted">Last updated November 10, 2026</p>
    </header>

    <section class={`mb-14 ${body}`}>
      <p>
        By accessing airtonvancin.com you agree to these terms and to all applicable laws and
        regulations, and you are responsible for complying with your local laws. If you don't
        agree with any of these terms, please don't use the site.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>license</h2>
      <div class={body}>
        <p>
          You may temporarily download one copy of the materials (information or software) on
          airtonvancin.com for personal, non-commercial, transitory viewing only. This is a
          license, not a transfer of title, and under it you may not:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Modify or copy the materials.</li>
          <li>Use the materials for any commercial purpose or public display, commercial or not.</li>
          <li>Decompile or reverse engineer any software on airtonvancin.com.</li>
          <li>Remove any copyright or other proprietary notices from the materials.</li>
          <li>Transfer the materials to another person or mirror them on any other server.</li>
        </ul>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>disclaimer</h2>
      <div class={body}>
        <p>
          The materials on airtonvancin.com are provided "as is". airtonvancin.com makes no
          warranties, expressed or implied, and disclaims all other warranties, including
          implied warranties of merchantability, fitness for a particular purpose, or
          non-infringement of intellectual property or other rights.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>limitations</h2>
      <div class={body}>
        <p>
          In no event shall airtonvancin.com or its suppliers be liable for any damages,
          including loss of data or profit or business interruption, arising from the use of or
          inability to use the materials on airtonvancin.com.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>accuracy</h2>
      <div class={body}>
        <p>
          The materials on airtonvancin.com may contain technical, typographical or photographic
          errors. airtonvancin.com does not warrant that any material is accurate, complete or
          current, and may change the materials at any time without notice.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>links</h2>
      <div class={body}>
        <p>
          airtonvancin.com has not reviewed every site it links to and is not responsible for
          their content. A link does not imply endorsement. Using any linked site is at your own
          risk.
        </p>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="term-title"><span aria-hidden="true">~/</span>governing-law</h2>
      <div class={body}>
        <p>
          These terms are governed by the laws of Brazil, and you submit to the exclusive
          jurisdiction of its courts. Questions? Email
          <a href="mailto:airtonvancin@gmail.com" class="quiet-link">airtonvancin@gmail.com</a>.
          See also the <a href="/politicas/" class="quiet-link">Privacy Policy</a>.
        </p>
      </div>
    </section>

    <MinimalFooter />
  </main>
</Layout>

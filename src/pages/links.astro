---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import avatar from "../assets/images/profile-avatar.png";
import lumeIqImg from "../assets/images/projects/lume-iq.png";
import jurosobraImg from "../assets/images/projects/jurosobra.jpg";
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandWordpress,
  IconMail,
  IconNews,
  IconArrowUpRight,
  IconShare,
  IconCheck,
  IconCircleCheckFilled,
  IconWashDrycleanOff,
  IconPuzzle,
  IconArticle,
  IconBuilding,
  IconSparkles,
  IconDeviceDesktop,
  IconMessageDots,
  IconArrowRight,
} from "@tabler/icons-react";
import { breadcrumbJsonLd } from "@/helpers/siteIdentity";

const site = Astro.site || new URL("https://airtonvancin.com");
const pageUrl = new URL(Astro.url.pathname, site).toString();

const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Home", path: "/" },
    { name: "Links", path: "/links/" },
  ],
  site,
  pageUrl
);

const socialLinks = [
  {
    href: "https://github.com/airton",
    label: "GitHub",
    icon: IconBrandGithub,
  },
  {
    href: "https://linkedin.com/in/airtonvancin",
    label: "LinkedIn",
    icon: IconBrandLinkedin,
  },
  {
    href: "https://profiles.wordpress.org/airtonvancin/",
    label: "WordPress",
    icon: IconBrandWordpress,
  },
  {
    href: "https://nichesignal.substack.com/?utm_campaign=airtonvancin.com",
    label: "Substack",
    icon: IconNews,
  },
  {
    href: "mailto:airtonvancin@gmail.com",
    label: "Email",
    icon: IconMail,
  },
];

const otherTools = [
  {
    title: "Balancewise.io",
    hook: "Rebalanceamento inteligente de carteiras de investimento.",
    badge: "SaaS",
    href: "https://balancewise.io/",
    icon: IconBuilding,
    external: true,
  },
  {
    title: "Gemini Flow Downloader",
    hook: "Extensão Chrome para exportar chats da IA em Markdown/JSON.",
    badge: "Chrome Extension",
    href: "/gemini-flow-downloader/",
    icon: IconSparkles,
    external: false,
  },
  {
    title: "Plugins WordPress Oficiais",
    hook: "5 plugins open source publicados no repositório oficial.",
    badge: "Open Source",
    href: "/plugins/",
    icon: IconPuzzle,
    external: false,
  },
  {
    title: "Timberoad",
    hook: "Dimensionamento solar e calculadoras para vanlife.",
    badge: "Web App",
    href: "https://timberoad.vercel.app/",
    icon: IconDeviceDesktop,
    external: true,
  },
];

const servicesAndContent = [
  {
    title: "Consultoria Zero Downtime",
    hook: "Deploy Blue-Green e infraestrutura de alta disponibilidade na AWS.",
    badge: "Cloud / DevOps",
    href: "/zero-downtime/",
    icon: IconWashDrycleanOff,
  },
  {
    title: "Prévias de Sites para Empresas",
    hook: "18 demonstrações ao vivo para comércios e empresas avaliarem.",
    badge: "Websites",
    href: "/previas/",
    icon: IconDeviceDesktop,
  },
  {
    title: "Blog Técnico & Artigos",
    hook: "+18 artigos sobre Astro, React, TypeScript e performance.",
    badge: "Artigos",
    href: "/blog/",
    icon: IconArticle,
  },
  {
    title: "Fale Comigo / Contato",
    hook: "Vamos conversar sobre projetos, parcerias ou consultoria.",
    badge: "Mensagem Direta",
    href: "/contato/",
    icon: IconMessageDots,
  },
];
---

<Layout
  title="Airton Vancin | Links & Projetos"
  description="Hub oficial de links de Airton Vancin. Projetos atuais em desenvolvimento (getlumeiq.com e jurosobra.com.br), ferramentas, plugins e contato."
  minimalNav={true}
  hideFooter={true}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumb)}
  />

  <!-- Top Floating Bar (Bio-link optimized) -->
  <header class="sticky top-0 z-40 w-full backdrop-blur-md bg-wall/80 dark:bg-night-wall/80 border-b border-hairline-faint dark:border-night-edge">
    <div class="max-w-md sm:max-w-lg mx-auto px-4 h-14 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs font-semibold text-ink dark:text-gallery-floor hover:text-brand dark:hover:text-brand-lifted transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-brand"></span>
        airtonvancin.com
      </a>

      <!-- Share Button -->
      <button
        id="share-profile-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-gallery-floor dark:bg-night-floor text-ink dark:text-gallery-floor border border-hairline dark:border-night-edge hover:border-brand-edge dark:hover:border-night-edge hover:text-brand dark:hover:text-brand-lifted transition-all active:scale-95 cursor-pointer"
        aria-label="Compartilhar perfil"
      >
        <IconShare className="w-3.5 h-3.5" />
        <span id="share-btn-text">Compartilhar</span>
      </button>
    </div>
  </header>

  <!-- Main Bio Links Container -->
  <main class="w-full min-h-[calc(100vh-3.5rem)] flex flex-col justify-between py-8 px-4">
    <div class="max-w-md sm:max-w-lg mx-auto w-full">
      <!-- Profile Header -->
      <div class="flex flex-col items-center text-center mb-8">
        <!-- Avatar with Active Pulse Ring -->
        <div class="relative mb-4 group">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-brand/20 dark:border-brand-lifted/30 p-1 shadow-resting">
            <Image
              src={avatar}
              alt="Airton Vancin"
              class="w-full h-full object-cover rounded-full"
              width={256}
              height={256}
              loading="eager"
            />
          </div>
          <!-- Live Status Indicator -->
          <span
            class="absolute bottom-1.5 right-1.5 w-5 h-5 rounded-full bg-wall dark:bg-night-wall flex items-center justify-center shadow-sm"
            title="Online • Criando novidades"
          >
            <span class="w-3.5 h-3.5 rounded-full bg-live-signal block animate-pulse"></span>
          </span>
        </div>

        <!-- Name & Verified Check -->
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-gallery-floor flex items-center justify-center gap-1.5 mb-1">
          Airton Vancin
          <IconCircleCheckFilled className="w-5 h-5 text-brand dark:text-brand-lifted shrink-0" />
        </h1>

        <p class="text-xs sm:text-sm font-semibold tracking-wide text-brand dark:text-brand-lifted mb-2">
          Senior Software Engineer & Maker
        </p>

        <p class="text-xs sm:text-sm text-quiet dark:text-quiet-faint max-w-sm leading-relaxed mb-4">
          +15 anos de engenharia de software. Construindo aplicações web rápidas, ferramentas inteligentes e produtos digitais.
        </p>

        <!-- Social Icons Row (Quick Contact) -->
        <div class="flex items-center justify-center gap-2 p-1.5 rounded-full bg-gallery-floor dark:bg-night-floor border border-hairline-faint dark:border-night-edge">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
                aria-label={social.label}
                class="flex items-center justify-center h-8 w-8 rounded-full text-quiet dark:text-quiet-faint hover:text-brand dark:hover:text-brand-lifted hover:bg-wall dark:hover:bg-night-wall transition-all"
              >
                <social.icon className="h-4 w-4" stroke={1.75} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- SECTION: PROJETOS ATUAIS EM DESTAQUE (HERO LINK BLOCKS) -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3 px-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-brand dark:text-brand-lifted flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-brand animate-ping"></span>
            Construindo Agora
          </span>
          <span class="text-[11px] font-medium text-quiet dark:text-quiet-faint">
            Novos Lançamentos
          </span>
        </div>

        <div class="space-y-3.5">
          <!-- CARD 1: LUME IQ (getlumeiq.com) -->
          <div class="group relative rounded-2xl bg-wall dark:bg-night-wall border-2 border-brand/30 dark:border-brand-lifted/30 shadow-resting hover:shadow-approach hover:border-brand transition-all duration-200 overflow-hidden">
            <!-- Subtle Top Accent Strip -->
            <div class="h-1 w-full bg-gradient-to-r from-brand via-brand-bright to-brand-lifted"></div>

            <div class="p-4 sm:p-5">
              <div class="flex items-start gap-3.5">
                <!-- Thumbnail -->
                <div class="w-16 h-16 rounded-xl overflow-hidden border border-hairline-faint dark:border-night-edge shrink-0 bg-gallery-floor dark:bg-night-floor">
                  <Image
                    src={lumeIqImg}
                    alt="Lume IQ"
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    width={128}
                    height={128}
                  />
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-1 mb-1">
                    <span class="text-[10px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded-full bg-status-ground text-status-ink border border-status-edge">
                      Lançamento
                    </span>
                    <span class="text-[11px] font-mono text-quiet dark:text-quiet-faint">
                      getlumeiq.com
                    </span>
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-ink dark:text-gallery-floor group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors leading-tight">
                    Lume IQ
                  </h3>
                  <p class="text-xs text-quiet dark:text-quiet-faint leading-snug line-clamp-2 mt-0.5">
                    Teste de QI online gratuito baseado em IRT. Pontuação instantânea com margem de erro, sem assinaturas.
                  </p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-3.5 pt-3 border-t border-hairline-faint dark:border-night-edge flex items-center justify-between gap-2">
                <a
                  href="/project/lume-iq/"
                  class="text-xs font-semibold text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors inline-flex items-center gap-1"
                >
                  Ver case study <IconArrowRight className="w-3.5 h-3.5" />
                </a>

                <a
                  href="https://getlumeiq.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-wall bg-brand hover:bg-brand-deep active:scale-95 transition-all shadow-sm"
                >
                  Acessar Site
                  <IconArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>

          <!-- CARD 2: JUROS DE OBRA (jurosobra.com.br) -->
          <div class="group relative rounded-2xl bg-wall dark:bg-night-wall border-2 border-brand/30 dark:border-brand-lifted/30 shadow-resting hover:shadow-approach hover:border-brand transition-all duration-200 overflow-hidden">
            <!-- Subtle Top Accent Strip -->
            <div class="h-1 w-full bg-gradient-to-r from-brand-deep via-brand to-brand-bright"></div>

            <div class="p-4 sm:p-5">
              <div class="flex items-start gap-3.5">
                <!-- Thumbnail -->
                <div class="w-16 h-16 rounded-xl overflow-hidden border border-hairline-faint dark:border-night-edge shrink-0 bg-gallery-floor dark:bg-night-floor">
                  <Image
                    src={jurosobraImg}
                    alt="Juros de Obra"
                    class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                    width={128}
                    height={128}
                  />
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-1 mb-1">
                    <span class="text-[10px] font-extrabold uppercase tracking-wide px-2 py-0.5 rounded-full bg-brand-wash dark:bg-night-edge text-brand dark:text-brand-lifted border border-brand-edge dark:border-night-edge">
                      Simulador
                    </span>
                    <span class="text-[11px] font-mono text-quiet dark:text-quiet-faint">
                      jurosobra.com.br
                    </span>
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-ink dark:text-gallery-floor group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors leading-tight">
                    Juros de Obra
                  </h3>
                  <p class="text-xs text-quiet dark:text-quiet-faint leading-snug line-clamp-2 mt-0.5">
                    Simulador financeiro para financiamento imobiliário na planta. Evolução de parcelas com INCC e SAC vs. Price.
                  </p>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-3.5 pt-3 border-t border-hairline-faint dark:border-night-edge flex items-center justify-between gap-2">
                <a
                  href="/project/jurosobra/"
                  class="text-xs font-semibold text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors inline-flex items-center gap-1"
                >
                  Ver case study <IconArrowRight className="w-3.5 h-3.5" />
                </a>

                <a
                  href="https://jurosobra.com.br"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-wall bg-brand hover:bg-brand-deep active:scale-95 transition-all shadow-sm"
                >
                  Acessar Simulador
                  <IconArrowUpRight className="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION: PRODUTOS & FERRAMENTAS -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3 px-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-quiet dark:text-quiet-faint">
            Mais Produtos & Ferramentas
          </span>
        </div>

        <div class="space-y-2.5">
          {
            otherTools.map((tool) => (
              <a
                href={tool.href}
                target={tool.external ? "_blank" : undefined}
                rel={tool.external ? "noopener noreferrer" : undefined}
                class="group flex items-center justify-between gap-3 p-3.5 rounded-xl bg-wall dark:bg-night-wall border border-hairline dark:border-night-edge shadow-resting hover:shadow-approach hover:border-brand-edge dark:hover:border-night-edge active:scale-[0.99] transition-all"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="p-2 rounded-lg bg-gallery-floor dark:bg-night-floor text-brand dark:text-brand-lifted shrink-0 group-hover:bg-brand-wash transition-colors">
                    <tool.icon className="w-4 h-4" stroke={1.75} />
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <h4 class="text-sm font-bold text-ink dark:text-gallery-floor group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors truncate">
                        {tool.title}
                      </h4>
                      <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-gallery-floor dark:bg-night-floor text-quiet dark:text-quiet-faint shrink-0">
                        {tool.badge}
                      </span>
                    </div>
                    <p class="text-[11px] text-quiet dark:text-quiet-faint truncate">
                      {tool.hook}
                    </p>
                  </div>
                </div>

                <div class="text-quiet dark:text-quiet-faint group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors shrink-0">
                  <IconArrowUpRight className="w-4 h-4" />
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- SECTION: SERVIÇOS, CONTEÚDO & CONTATO -->
      <div class="mb-8">
        <div class="flex items-center justify-between mb-3 px-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-quiet dark:text-quiet-faint">
            Serviços & Contato
          </span>
        </div>

        <div class="space-y-2.5">
          {
            servicesAndContent.map((item) => (
              <a
                href={item.href}
                class="group flex items-center justify-between gap-3 p-3.5 rounded-xl bg-wall dark:bg-night-wall border border-hairline dark:border-night-edge shadow-resting hover:shadow-approach hover:border-brand-edge dark:hover:border-night-edge active:scale-[0.99] transition-all"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <div class="p-2 rounded-lg bg-gallery-floor dark:bg-night-floor text-brand dark:text-brand-lifted shrink-0 group-hover:bg-brand-wash transition-colors">
                    <item.icon className="w-4 h-4" stroke={1.75} />
                  </div>
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5">
                      <h4 class="text-sm font-bold text-ink dark:text-gallery-floor group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors truncate">
                        {item.title}
                      </h4>
                      <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-gallery-floor dark:bg-night-floor text-quiet dark:text-quiet-faint shrink-0">
                        {item.badge}
                      </span>
                    </div>
                    <p class="text-[11px] text-quiet dark:text-quiet-faint truncate">
                      {item.hook}
                    </p>
                  </div>
                </div>

                <div class="text-quiet dark:text-quiet-faint group-hover:text-brand dark:group-hover:text-brand-lifted transition-colors shrink-0">
                  <IconArrowRight className="w-4 h-4 group-hover:translate-x-0.5 transition-transform" />
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Primary Website Direct CTA -->
      <div class="text-center pt-2 pb-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-bold text-ink dark:text-gallery-floor hover:text-brand dark:hover:text-brand-lifted transition-colors py-2 px-4 rounded-full border border-hairline dark:border-night-edge bg-gallery-floor dark:bg-night-floor hover:border-brand-edge"
        >
          Visitar site completo airtonvancin.com
          <IconArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

    <!-- Minimal Bio-Link Footer -->
    <footer class="text-center pt-6 pb-2 text-[11px] text-quiet dark:text-quiet-faint">
      <p>© {new Date().getFullYear()} Airton Vancin • Feito para compartilhar nas redes</p>
    </footer>
  </main>

  <!-- Toast Notification (Floating) -->
  <div
    id="share-toast"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-2 px-4 py-2.5 rounded-full bg-ink text-wall dark:bg-gallery-floor dark:text-ink text-xs font-semibold shadow-2xl opacity-0 pointer-events-none translate-y-3 transition-all duration-300"
    role="status"
    aria-live="polite"
  >
    <IconCheck className="w-4 h-4 text-live-signal shrink-0" />
    <span id="toast-message">Link copiado para a área de transferência!</span>
  </div>

  <!-- Interactive Web Share & Copy Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const shareBtn = document.getElementById("share-profile-btn");
      const shareBtnText = document.getElementById("share-btn-text");
      const toast = document.getElementById("share-toast");
      const toastMsg = document.getElementById("toast-message");

      function showToast(message) {
        if (!toast) return;
        if (toastMsg) toastMsg.textContent = message;
        toast.classList.remove("opacity-0", "pointer-events-none", "translate-y-3");
        toast.classList.add("opacity-100", "translate-y-0");
        setTimeout(() => {
          toast.classList.add("opacity-0", "pointer-events-none", "translate-y-3");
          toast.classList.remove("opacity-100", "translate-y-0");
        }, 2500);
      }

      if (shareBtn) {
        shareBtn.addEventListener("click", async () => {
          const shareData = {
            title: "Airton Vancin | Links & Projetos",
            text: "Confira os projetos e links de Airton Vancin (getlumeiq.com, jurosobra.com.br e mais)",
            url: window.location.href,
          };

          // Try native mobile Web Share API first
          if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
            try {
              await navigator.share(shareData);
              return;
            } catch (err) {
              if (err.name === "AbortError") return; // User closed the native share dialog
            }
          }

          // Fallback to Clipboard copy
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (shareBtnText) shareBtnText.textContent = "Copiado!";
            showToast("Link copiado para a área de transferência!");
            setTimeout(() => {
              if (shareBtnText) shareBtnText.textContent = "Compartilhar";
            }, 2000);
          } catch (err) {
            console.error("Erro ao copiar link:", err);
            showToast("Não foi possível copiar o link.");
          }
        });
      }
    });
  </script>
</Layout>

---
import MinimalPage from "../components/MinimalPage.astro";

const body = "space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";

const benefits = [
  { title: "Zero downtime", desc: "Ship updates without interrupting the service." },
  { title: "Instant rollback", desc: "Go back to the previous version in seconds." },
  { title: "Lower risk", desc: "Test the new version before anyone sees it." },
];

const stack = [
  { name: "CloudFront", desc: "CDN for global delivery" },
  { name: "Key Value Store", desc: "Holds which version is live" },
  { name: "S3", desc: "Stores each build" },
  { name: "GitHub Actions", desc: "Automated CI/CD" },
];
---

<MinimalPage
  title="Front-end Zero Downtime | Airton Vancin"
  description="Blue-green deployments for front-end apps on AWS: keep your web app always available, with instant rollback and no lost revenue."
  heading="Front-end Zero Downtime"
  subheading="Blue-green deploys on AWS"
>
  <section class={`mb-14 ${body}`}>
    <p>
      Keep your web apps always available: no interruptions during deploys and no lost revenue.
      Built and running on AWS, and easy to adapt to Google Cloud, Azure or other providers.
    </p>
  </section>

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>how-it-works</h2>
    <div class={body}>
      <p>
        It uses blue-green deployment: two copies of the environment run side by side, which cuts
        both downtime and risk.
      </p>
      <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
        <div class="grid grid-cols-[5rem_1fr] gap-x-4 py-2.5">
          <dt class="font-medium text-ink dark:text-gallery-floor">Blue</dt>
          <dd>The current production version: stable, tested and serving users.</dd>
        </div>
        <div class="grid grid-cols-[5rem_1fr] gap-x-4 py-2.5">
          <dt class="font-medium text-ink dark:text-gallery-floor">Green</dt>
          <dd>The new version, tested in isolation before the switch.</dd>
        </div>
      </dl>
      <p>
        Once Green checks out, traffic moves over instantly. If something goes wrong, you switch
        back to Blue. Every release is safe and continuous.
      </p>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>benefits</h2>
    <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
      {
        benefits.map((b) => (
          <li class="py-2.5">
            <p class="font-medium">{b.title}</p>
            <p class="text-sm text-quiet dark:text-quiet-lifted mt-0.5">{b.desc}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>aws-stack</h2>
    <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
      {
        stack.map((s) => (
          <div class="grid sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-0.5 py-2.5">
            <dt class="font-medium">{s.name}</dt>
            <dd class="text-quiet dark:text-quiet-lifted">{s.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mb-16">
    <h2 class="term-title"><span aria-hidden="true">~/</span>get-it</h2>
    <p class={body}>
      Want this in your company? <a href="mailto:airtonvancin@gmail.com?subject=Zero%20Downtime" class="quiet-link">Email me</a>
      or see the other ways to <a href="/contato/" class="quiet-link">get in touch</a>, and we'll look at how it fits
      your project.
    </p>
  </section>
</MinimalPage>

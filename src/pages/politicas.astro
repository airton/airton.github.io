---
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "../components/MinimalFooter.astro";

const body = "space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";
---

<Layout
  title="Privacy Policy | Airton Vancin"
  description="How airtonvancin.com handles your data: analytics, Google AdSense cookies, third-party links and how to opt out."
  lang="en"
  image="/og-home.png"
  minimalNav={true}
  hideFooter={true}
>
  <main class="font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <a href="/" class="text-sm text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors">
      ← Home
    </a>

    <header class="mt-10 mb-14">
      <h1 class="font-plex text-xl font-semibold tracking-tight">Privacy Policy</h1>
      <p class="text-sm text-quiet dark:text-quiet-lifted">Last updated November 10, 2026</p>
    </header>

    <section class={`mb-14 ${body}`}>
      <p>
        Your privacy matters. This page explains what airtonvancin.com collects when you visit,
        why, and how to opt out. The same applies to any other site I own and operate.
      </p>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>personal-data</h2>
      <div class={body}>
        <p>
          I only ask for personal information when I need it to provide a service, such as
          replying to a message you send me. I collect it by fair and lawful means, with your
          knowledge and consent, and I tell you why and how it will be used.
        </p>
        <p>
          I keep that information only as long as needed to provide the service, and protect it
          by commercially acceptable means against loss, theft and unauthorized access,
          disclosure, copying, use or modification.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>analytics</h2>
      <div class={body}>
        <p>
          The site uses Google Analytics to count visits and see which pages are read. It sets
          cookies and collects aggregated data such as pages viewed, referrer, device type and
          approximate location. I don't use it to identify you. You can block it with the
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="quiet-link">Google Analytics opt-out add-on</a>.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>ads-and-cookies</h2>
      <div class={body}>
        <p>
          Some pages show ads from Google AdSense. Google, as a third-party vendor, uses cookies
          to serve ads on this site.
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>
            Third-party vendors, including Google, use cookies to serve ads based on your prior
            visits to this website or other websites.
          </li>
          <li>
            Google's use of advertising cookies enables it and its partners to serve ads based on
            your visits to this site and/or other sites on the Internet.
          </li>
          <li>
            You can opt out of personalized advertising in
            <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="quiet-link">Google Ads Settings</a>,
            or opt out of third-party vendors' cookies at
            <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="quiet-link">aboutads.info</a>.
          </li>
        </ul>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>third-party-links</h2>
      <div class={body}>
        <p>
          This site links to external sites that I don't operate. I have no control over their
          content or practices and can't accept responsibility for their privacy policies.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>your-commitment</h2>
      <div class={body}>
        <p>By using the site, you agree to use its content and information appropriately, including:</p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Not engaging in activities that are illegal or contrary to good faith and public order.</li>
          <li>
            Not spreading racist or xenophobic content, gambling or online betting promotion, illegal
            pornography, or content that supports terrorism or violates human rights.
          </li>
          <li>Not damaging the hardware or software of airtonvancin.com, its providers or third parties.</li>
        </ul>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="term-title"><span aria-hidden="true">~/</span>contact</h2>
      <div class={body}>
        <p>
          This policy is effective as of December 2025. If you have any questions, email
          <a href="mailto:airtonvancin@gmail.com" class="quiet-link">airtonvancin@gmail.com</a>.
          See also the <a href="/termos/" class="quiet-link">Terms of Use</a>.
        </p>
      </div>
    </section>

    <MinimalFooter />
  </main>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import SiteShell from "../components/SiteShell.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import avatar from "../assets/images/profile-avatar.png";
import { projects, BUILDING } from "../data/projects";
import { plugins } from "../data/plugins";
import { getGithubActivity } from "../helpers/githubActivity";
import {
  IconBrandAstro,
  IconBrandAws,
  IconBrandDocker,
  IconBrandGithub,
  IconBrandJavascript,
  IconBrandLinkedin,
  IconBrandNodejs,
  IconBrandOpenai,
  IconBrandPhp,
  IconBrandReact,
  IconBrandTailwind,
  IconBrandTypescript,
  IconBrandVercel,
  IconBrandWordpress,
  IconBrandX,
  IconMail,
} from "@tabler/icons-react";

const socialLinks = [
  { href: "https://x.com/a_vancin", label: "X", icon: IconBrandX },
  { href: "https://github.com/airton", label: "GitHub", icon: IconBrandGithub },
  { href: "https://linkedin.com/in/airtonvancin", label: "LinkedIn", icon: IconBrandLinkedin },
  { href: "https://profiles.wordpress.org/airtonvancin/", label: "WordPress", icon: IconBrandWordpress },
];

/* The stack, floating around the hero. Positions are percentages of the hero
   box, hand-placed to keep clear of the centred copy column. */
const stack = [
  { icon: IconBrandWordpress, label: "WordPress", x: 9, y: 12 },
  { icon: IconBrandReact, label: "React", x: 22, y: 30 },
  { icon: IconBrandTypescript, label: "TypeScript", x: 6, y: 52 },
  { icon: IconBrandNodejs, label: "Node.js", x: 18, y: 74 },
  { icon: IconBrandAws, label: "AWS", x: 4, y: 90 },
  { icon: IconBrandAstro, label: "Astro", x: 30, y: 6 },
  { icon: IconBrandOpenai, label: "OpenAI", x: 72, y: 7 },
  { icon: IconBrandPhp, label: "PHP", x: 88, y: 18 },
  { icon: IconBrandJavascript, label: "JavaScript", x: 79, y: 36 },
  { icon: IconBrandDocker, label: "Docker", x: 93, y: 54 },
  { icon: IconBrandTailwind, label: "Tailwind", x: 81, y: 76 },
  { icon: IconBrandVercel, label: "Vercel", x: 95, y: 92 },
];

// One line per project — the long `desc` in projects.ts is the Portuguese
// case-study copy and is too heavy for a table row.
const projectHooks: Record<string, string> = {
  declone: "Finds fake and cloned copies of your site on lookalike domains.",
  "lume-iq": "Free online IQ test with IRT scoring and a margin of error.",
  jurosobra: "Interest simulator for off-plan home financing in Brazil.",
  balancewise: "Smart investment portfolio rebalancing.",
  timberoad: "Solar sizing calculators and planning tools for vanlife.",
  "pablo-escobar-ipsum": "Lorem Ipsum, Narcos edition.",
};

const pluginHooks: Record<string, string> = {
  "video-destacado": "Use a YouTube or Vimeo video as the featured image.",
  "manage-user-roles": "Create and edit user roles and capabilities.",
  "nudge-seo-ai": "AI-generated SEO suggestions inside the editor.",
  "sso-connector-for-jumpcloud": "SAML single sign-on with JumpCloud.",
  "notria-ai-suite": "A suite of AI tools for WordPress.",
};

const domainOf = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const building = projects.filter((p) => BUILDING.has(p.slug));
const shipped = projects.filter((p) => !BUILDING.has(p.slug));

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const activity = await getGithubActivity("airton");
const fmt = (n: number) => n.toLocaleString("en-US");
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Layout
  title="Airton Vancin | AI Engineer & Builder"
  description="Airton Vancin — Engineering Director, AI, with 15+ years in software engineering. Builds side projects and WordPress plugins, and writes about lessons from the work."
  lang="en"
  image="/og-card.png"
  minimalNav={true}
  hideFooter={true}
>
  <SiteShell>
      <main class="home">
        <!-- Hero -->
        <section class="hero">
          <div class="stack" aria-hidden="true">
            {
              stack.map((s, i) => (
                <span class:list={["tile", s.y > 25 && "low"]} style={`left:${s.x}%;top:${s.y}%;--d:${(i % 5) * -1.3}s`} title={s.label}>
                  <s.icon className="w-6 h-6" stroke={1.5} />
                </span>
              ))
            }
          </div>

          <button type="button" class="gravity" id="gravity-toggle" aria-pressed="false">
            <span class="gravity-ico" aria-hidden="true">↓</span>
            <span class="gravity-label">Disable gravity</span>
          </button>

          <div class="photo">
            <Image src={avatar} alt="Airton Vancin" width={168} height={168} loading="eager" />
          </div>

          <p class="brand"><span aria-hidden="true">✦</span>Airton Vancin</p>

          {
            activity && (
              <a href="https://github.com/airton" target="_blank" rel="me noopener noreferrer" class="pill">
                <i aria-hidden="true" />
                <strong>{fmt(activity.total)}</strong> GitHub contributions this year
              </a>
            )
          }

          <h1>I build small, fast and useful things.</h1>
          <p class="sub">
            Engineering Director in AI, after more than 15 years writing software across WordPress, React,
            Node.js and AWS. In my spare time, I ship side projects and plugins, and write about what I learn.
          </p>

          <div class="actions">
            <a href="/contato/" class="btn btn-dark"><IconMail className="w-4 h-4" stroke={1.75} /> Contact me</a>
            <a href="/blog/" class="btn btn-light">Read the writing <span aria-hidden="true">→</span></a>
          </div>

          <nav aria-label="Social links" class="social">
            {
              socialLinks.map((s) => (
                <a href={s.href} aria-label={s.label} target="_blank" rel="me noopener noreferrer">
                  <s.icon className="w-[18px] h-[18px]" stroke={1.75} />
                </a>
              ))
            }
          </nav>
        </section>

        <!-- Currently building -->
        <section class="section">
          <div class="head">
            <div>
              <p class="kicker">Currently building</p>
              <h2>What's on the bench right now.</h2>
            </div>
            <span class="live"><i aria-hidden="true" />Updated as I ship</span>
          </div>
          <div class="tbl">
            <div class="thead cols-3" aria-hidden="true">
              <span>Project</span><span>Domain</span><span>Status</span>
            </div>
            {
              building.map((p) => (
                <a href={p.link} target="_blank" rel="noopener noreferrer" class="trow cols-3">
                  <div class="cell-main">
                    <Image src={p.logo} alt="" width={84} height={84} class="mark" />
                    <div class="min-w-0">
                      <h3>{p.name}</h3>
                      <p>{projectHooks[p.slug] ?? p.desc}</p>
                    </div>
                  </div>
                  <span class="mono">{domainOf(p.link)}</span>
                  <span>
                    <span class="status"><i aria-hidden="true" />Building</span>
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        <!-- Shipped -->
        <section class="section pt-0">
          <div class="head">
            <div>
              <p class="kicker kicker-muted">Software</p>
              <h2>Shipped and live.</h2>
            </div>
            <span class="shipped"><i aria-hidden="true">✓</i>Shipped</span>
          </div>
          <div class="tbl">
            <div class="thead cols-3" aria-hidden="true">
              <span>App</span><span>Platform</span><span>Link</span>
            </div>
            {
              shipped.map((p) => (
                <a href={p.link} target="_blank" rel="noopener noreferrer" class="trow cols-3">
                  <div class="cell-main">
                    <Image src={p.logo} alt="" width={84} height={84} class="mark" />
                    <div class="min-w-0">
                      <h3>{p.name}</h3>
                      <p>{projectHooks[p.slug] ?? p.desc}</p>
                    </div>
                  </div>
                  <span class="mono">Web app</span>
                  <span class="link">{domainOf(p.link)} <span aria-hidden="true">↗</span></span>
                </a>
              ))
            }
            <a href="/en/gemini-flow-downloader/" class="trow cols-3">
              <div class="cell-main">
                <span class="mark mark-text">G</span>
                <div class="min-w-0">
                  <h3>Gemini Flow Downloader</h3>
                  <p>Export Gemini chats to Markdown or JSON.</p>
                </div>
              </div>
              <span class="mono">Chrome extension</span>
              <span class="link">Download <span aria-hidden="true">→</span></span>
            </a>
          </div>
          <a href="/projetos/" class="more">All projects →</a>
        </section>

        <!-- Plugins -->
        <section class="section bordered">
          <div class="intro">
            <div>
              <p class="kicker kicker-green">WordPress.org</p>
              <h2>Plugins in the official directory.</h2>
            </div>
            <p>
              Open-source plugins I wrote and maintain, from video thumbnails to SAML single sign-on. Each one
              has its own page with setup notes.
            </p>
          </div>
          <div class="grid2">
            {
              plugins.map((p) => (
                <a href={`/en/plugin/${p.slug}/`} class="gcell">
                  <span class="round">
                    <IconBrandWordpress className="w-5 h-5" stroke={1.5} />
                  </span>
                  <div class="min-w-0">
                    <h3>{p.name}</h3>
                    <p>{pluginHooks[p.slug] ?? p.en.desc}</p>
                  </div>
                </a>
              ))
            }
          </div>
          <p class="loop">
            Write <i>→</i> Ship <i>→</i> Maintain <i>→</i> Share
          </p>
        </section>

        <!-- Activity -->
        {
          activity && (
            <section class="section bordered center">
              <p class="kicker">On GitHub</p>
              <h2>Most of the building happens in the open.</h2>
              <div class="heatcard">
                <div
                  class="activity-grid"
                  style={`--weeks: ${activity.weeks.length}`}
                  role="img"
                  aria-label={`GitHub contributions over the last year: ${fmt(activity.total)} in total.`}
                >
                  {activity.weeks.map((week) =>
                    week.map((day) => (
                      <span class:list={["cell", day ? `l${day.level}` : "empty"]} title={day?.date} />
                    ))
                  )}
                </div>
              </div>
              <div class="stats">
                <span>
                  <strong>{fmt(activity.total)}</strong>contributions
                </span>
                <span>
                  <strong>{fmt(activity.activeDays)}</strong>active days
                </span>
                <span>
                  <strong>{activity.streak > 1 ? `${activity.streak} days` : fmt(plugins.length)}</strong>
                  {activity.streak > 1 ? "current streak" : "plugins shipped"}
                </span>
              </div>
              <a href="https://github.com/airton" target="_blank" rel="me noopener noreferrer" class="more">
                github.com/airton ↗
              </a>
            </section>
          )
        }

        <!-- Writing -->
        <section class="section bordered">
          <div class="head">
            <div>
              <p class="kicker">Writing</p>
              <h2>Notes from the work.</h2>
            </div>
          </div>
          <div class="tbl">
            <div class="thead cols-post" aria-hidden="true">
              <span>Post</span><span>Published</span>
            </div>
            {
              posts.map((post) => (
                <a href={`/blog/${post.id}/`} class="trow cols-post post">
                  <h3>{post.data.title}</h3>
                  <time datetime={post.data.date.toISOString()} class="mono">
                    {formatDate(post.data.date)}
                  </time>
                </a>
              ))
            }
          </div>
          <a href="/blog/" class="more">All posts →</a>
        </section>

        <!-- Work with me -->
        <section class="cta">
          <p class="kicker kicker-warm">Work with me</p>
          <h2>Need a hand with infrastructure, WordPress or a new website?</h2>
          <p>Blue-green deploys and high availability on AWS, plugin engineering, or a business site you can see live before you decide.</p>
          <div class="cta-links">
            <a href="/zero-downtime/">Zero Downtime</a>
            <a href="/previas/">Business websites</a>
            <a href="/contato/">Get in touch</a>
          </div>
        </section>

      </main>

  </SiteShell>

</Layout>



<script>
  /*
    "Disable gravity": the floating stack tiles drop, bounce and pile up on the
    hero floor, and can be grabbed and thrown. "Restore gravity" floats them
    back to their places. Plain circle physics — the tiles are near-square, so
    treating them as circles keeps collisions cheap and stacking stable.
  */
  const stack = document.querySelector<HTMLElement>(".hero .stack");
  const button = document.getElementById("gravity-toggle");
  const label = button?.querySelector(".gravity-label");
  const ico = button?.querySelector(".gravity-ico");

  if (stack && button && label && ico) {
    type Body = { el: HTMLElement; x: number; y: number; vx: number; vy: number; a: number; va: number; size: number };

    const G = 2600; // px/s²
    const BOUNCE = 0.42;
    const FRICTION = 0.985;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let bodies: Body[] = [];
    let running = false;
    let falling = false;
    let raf = 0;
    let last = 0;
    let drag: { b: Body; dx: number; dy: number; lx: number; ly: number; lt: number } | null = null;

    const visibleTiles = () =>
      [...stack.querySelectorAll<HTMLElement>(".tile")].filter((t) => getComputedStyle(t).display !== "none");

    const bounds = () => ({ w: stack.clientWidth, h: stack.clientHeight });

    function render() {
      for (const b of bodies) {
        b.el.style.transform = `translate(${b.x}px, ${b.y}px) rotate(${b.a}deg)`;
      }
    }

    function step(dt: number) {
      const { w, h } = bounds();
      for (const b of bodies) {
        if (drag?.b === b) continue;
        b.vy += G * dt;
        b.vx *= FRICTION;
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        b.a += b.va * dt;
        if (b.y + b.size > h) {
          b.y = h - b.size;
          b.vy = -b.vy * BOUNCE;
          b.vx *= 0.8;
          b.va *= 0.6;
          if (Math.abs(b.vy) < 40) b.vy = 0;
        }
        if (b.x < 0) {
          b.x = 0;
          b.vx = -b.vx * BOUNCE;
        } else if (b.x + b.size > w) {
          b.x = w - b.size;
          b.vx = -b.vx * BOUNCE;
        }
      }
      // Pairwise collisions, a few passes so piles settle instead of sinking.
      for (let pass = 0; pass < 4; pass++) {
        for (let i = 0; i < bodies.length; i++) {
          for (let j = i + 1; j < bodies.length; j++) {
            const p = bodies[i];
            const q = bodies[j];
            const r = (p.size + q.size) / 2;
            const dx = q.x + q.size / 2 - (p.x + p.size / 2);
            const dy = q.y + q.size / 2 - (p.y + p.size / 2);
            const d = Math.hypot(dx, dy) || 0.01;
            if (d >= r) continue;
            const nx = dx / d;
            const ny = dy / d;
            const push = (r - d) / 2;
            const pFixed = drag?.b === p;
            const qFixed = drag?.b === q;
            if (!pFixed) {
              p.x -= nx * push * (qFixed ? 2 : 1);
              p.y -= ny * push * (qFixed ? 2 : 1);
            }
            if (!qFixed) {
              q.x += nx * push * (pFixed ? 2 : 1);
              q.y += ny * push * (pFixed ? 2 : 1);
            }
            const rel = (q.vx - p.vx) * nx + (q.vy - p.vy) * ny;
            if (rel < 0) {
              const imp = (-(1 + BOUNCE) * rel) / 2;
              if (!pFixed) {
                p.vx -= imp * nx;
                p.vy -= imp * ny;
              }
              if (!qFixed) {
                q.vx += imp * nx;
                q.vy += imp * ny;
              }
              p.va += rel * 0.15;
              q.va -= rel * 0.15;
            }
          }
        }
      }
    }

    const settled = () => !drag && bodies.every((b) => Math.abs(b.vx) < 6 && Math.abs(b.vy) < 6 && Math.abs(b.va) < 4);

    function loop(t: number) {
      const dt = Math.min((t - last) / 1000, 1 / 30);
      last = t;
      // Two substeps per frame keep fast tiles from tunnelling through each other.
      step(dt / 2);
      step(dt / 2);
      render();
      if (settled()) {
        running = false;
        return;
      }
      raf = requestAnimationFrame(loop);
    }

    function wake() {
      if (running || reduced) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(loop);
    }

    function drop() {
      const box = stack.getBoundingClientRect();
      bodies = visibleTiles().map((el) => {
        const r = el.getBoundingClientRect();
        return {
          el,
          x: r.left - box.left,
          y: r.top - box.top,
          vx: (Math.random() - 0.5) * 260,
          vy: -Math.random() * 180,
          a: 0,
          va: (Math.random() - 0.5) * 240,
          size: r.width,
        };
      });
      stack.classList.add("falling");
      if (reduced) {
        // No motion: run the simulation off-screen and show where it lands.
        for (let i = 0; i < 900; i++) step(1 / 120);
        render();
      } else {
        render();
        wake();
      }
    }

    function restore() {
      cancelAnimationFrame(raf);
      running = false;
      drag = null;
      const { w, h } = bounds();
      // Fly each tile back to its resting spot (the inline left/top %, centred),
      // then hand it back to the CSS layout, which puts it in the same place.
      stack.classList.add("returning");
      for (const b of bodies) {
        const hx = (parseFloat(b.el.style.left) / 100) * w - b.size / 2;
        const hy = (parseFloat(b.el.style.top) / 100) * h - b.size / 2;
        b.el.style.transform = `translate(${hx}px, ${hy}px) rotate(0deg)`;
      }
      const done = () => {
        stack.classList.remove("falling", "returning");
        for (const b of bodies) b.el.style.transform = "";
        bodies = [];
      };
      if (reduced) done();
      else setTimeout(done, 900);
    }

    button.addEventListener("click", () => {
      falling = !falling;
      button.setAttribute("aria-pressed", String(falling));
      label.textContent = falling ? "Restore gravity" : "Disable gravity";
      ico.textContent = falling ? "↑" : "↓";
      if (falling) drop();
      else restore();
    });

    // Grab and throw while the tiles are down.
    stack.addEventListener("pointerdown", (e) => {
      if (!falling) return;
      const b = bodies.find((b) => b.el === (e.target as HTMLElement).closest(".tile"));
      if (!b) return;
      e.preventDefault(); // no text selection while dragging across the hero
      const box = stack.getBoundingClientRect();
      drag = { b, dx: e.clientX - box.left - b.x, dy: e.clientY - box.top - b.y, lx: e.clientX, ly: e.clientY, lt: e.timeStamp };
      b.el.setPointerCapture(e.pointerId);
      b.el.classList.add("grabbed");
      b.vx = b.vy = 0;
      wake();
    });
    stack.addEventListener("pointermove", (e) => {
      if (!drag) return;
      const box = stack.getBoundingClientRect();
      const { w, h } = bounds();
      const b = drag.b;
      const dt = Math.max((e.timeStamp - drag.lt) / 1000, 1 / 240);
      b.vx = (e.clientX - drag.lx) / dt;
      b.vy = (e.clientY - drag.ly) / dt;
      drag.lx = e.clientX;
      drag.ly = e.clientY;
      drag.lt = e.timeStamp;
      b.x = Math.min(Math.max(e.clientX - box.left - drag.dx, 0), w - b.size);
      b.y = Math.min(Math.max(e.clientY - box.top - drag.dy, 0), h - b.size);
      if (reduced) render();
    });
    const release = () => {
      if (!drag) return;
      const b = drag.b;
      b.el.classList.remove("grabbed");
      const cap = 2400;
      b.vx = Math.max(-cap, Math.min(cap, b.vx));
      b.vy = Math.max(-cap, Math.min(cap, b.vy));
      drag = null;
      if (reduced) {
        for (let i = 0; i < 900; i++) step(1 / 120);
        render();
      } else wake();
    };
    // On the window too: a release outside the hero (or a lost capture) must
    // still let go, or the tile would hang in mid-air.
    addEventListener("pointerup", release);
    addEventListener("pointercancel", release);
    stack.addEventListener("lostpointercapture", release);

    // Keep fallen tiles inside the hero when the window changes size.
    addEventListener("resize", () => {
      if (!falling) return;
      if (reduced) {
        for (let i = 0; i < 900; i++) step(1 / 120);
        render();
      } else wake();
    });
  }
</script>

<style>
  .home {
    --ink: #151515;
    --muted: #6b6b6b;
    --faint: #8a8a86;
    --line: #ddddda;
    --line-soft: #e8e8e4;
    --paper: #fbfbfa;
    --card: #ffffff;
    --head: #f6f6f4;
    --blue: #3558ff;
    --green: #218d4d;
    --green-bg: #e8f8ed;
    --pulse: #28b665;
    --warm: #b64f24;
    --display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;

    flex: 1;
    background: var(--paper);
    color: var(--ink);
    font-family: "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  .home a {
    color: inherit;
    text-decoration: none;
  }
  .home h1,
  .home h2,
  .home h3 {
    font-family: var(--display);
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .home :focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Top bar */

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 76px 24px 84px;
  }
  .hero > :not(.stack) {
    position: relative;
    z-index: 2;
  }
  .stack {
    position: absolute;
    inset: 24px 0 24px;
    pointer-events: none;
  }
  .stack::before {
    content: "";
    position: absolute;
    inset: 0 3%;
    background-image:
      linear-gradient(#5467d612 1px, transparent 1px),
      linear-gradient(90deg, #5467d612 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(#000 10%, #000c 46%, transparent 76%);
    animation: mesh 18s linear infinite;
  }
  .tile {
    position: absolute;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: -27px 0 0 -27px;
    border-radius: 16px;
    background: #111;
    color: #fff;
    border: 1px solid #ffffff24;
    box-shadow: 0 8px 30px #2d356014;
    animation: drift 7s ease-in-out infinite;
    animation-delay: var(--d);
  }
  /* Gravity toggle and the fallen state. Once dropped, a tile's position is
     owned by the script (a transform from the stack's top-left corner), so
     the % placement, centring margin and drift animation all step aside. */
  .hero > .gravity {
    position: absolute;
    z-index: 3;
    top: 28px;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;

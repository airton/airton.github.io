---
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "../components/MinimalFooter.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import avatar from "../assets/images/profile-avatar.png";
import ProjectGrid from "../components/ProjectGrid.astro";
import PluginList from "../components/PluginList.astro";
import { getGithubActivity } from "../helpers/githubActivity";
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandWordpress,
  IconBrandX,
  IconMail,
} from "@tabler/icons-react";

const pageLinks = [
  { href: "/sobre/", label: "About" },
  { href: "/projetos/", label: "Projects" },
  { href: "/en/plugins/", label: "Plugins" },
  { href: "/blog/", label: "Writing" },
  { href: "/contato/", label: "Contact" },
];

const socialLinks = [
  { href: "https://x.com/a_vancin", label: "X", icon: IconBrandX },
  { href: "https://github.com/airton", label: "GitHub", icon: IconBrandGithub },
  { href: "https://linkedin.com/in/airtonvancin", label: "LinkedIn", icon: IconBrandLinkedin },
  { href: "https://profiles.wordpress.org/airtonvancin/", label: "WordPress", icon: IconBrandWordpress },
  { href: "mailto:airtonvancin@gmail.com", label: "Email", icon: IconMail },
];

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const activity = await getGithubActivity("airton");
const fmt = (n: number) => n.toLocaleString("en-US");

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<Layout
  title="Airton Vancin | AI Engineer & Builder"
  description="Airton Vancin — Engineering Director, AI, with 15+ years in software engineering. Builds side projects and WordPress plugins, and writes about lessons from the work."
  lang="en"
  image="/og-home.png"
  minimalNav={true}
  hideFooter={true}
>
  <main class="home font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <!-- Header -->
    <header class="mb-14">
      <div class="flex items-center gap-4 mb-5">
        <Image
          src={avatar}
          alt="Airton Vancin"
          width={112}
          height={112}
          loading="eager"
          class="w-14 h-14 rounded-full object-cover"
        />
        <div>
          <h1 class="font-plex text-xl font-semibold tracking-tight">Airton Vancin</h1>
          <p class="text-sm text-quiet dark:text-quiet-lifted">AI Engineer & Builder</p>
        </div>
      </div>

      <nav aria-label="Social links" class="flex items-center gap-1 -ml-2">
        {
          socialLinks.map((s) => (
            <a
              href={s.href}
              aria-label={s.label}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "me noopener noreferrer" : undefined}
              class="p-2 rounded-md text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors"
            >
              <s.icon className="w-[18px] h-[18px]" stroke={1.75} />
            </a>
          ))
        }
      </nav>

      <nav aria-label="Pages" class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {pageLinks.map((l) => <a href={l.href} class="quiet-link">{l.label}</a>)}
      </nav>
    </header>

    <!-- About -->
    <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
      <p>
        I work as an Engineering Director in AI, after more than 15 years writing software
        across WordPress, React, Node.js and AWS infrastructure. In my spare time, I build
        side projects.
      </p>
      <p>
        I like things that are small, fast and useful. Below is what I'm building, what I've
        shipped and what I've been writing along the way. <a href="/sobre/" class="quiet-link">More about me →</a>
      </p>
    </section>

    <!-- Projects -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>projects</h2>
      <ProjectGrid />
      <a href="/projetos/" class="quiet-link inline-block mt-4 text-sm">All projects →</a>
    </section>

    <!-- Plugins -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>plugins</h2>
      <PluginList />
      <a href="/en/plugins/" class="quiet-link inline-block mt-4 text-sm">All plugins →</a>
    </section>

    <!-- Activity -->
    {
      activity && (
        <section class="mb-14">
          <h2 class="term-title"><span aria-hidden="true">~/</span>activity</h2>
          <p class="text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted mb-5">
            Most of my building happens on GitHub, between work and side projects.
          </p>
          <div
            class="activity-grid"
            style={`--weeks: ${activity.weeks.length}`}
            role="img"
            aria-label={`GitHub contributions over the last year: ${fmt(activity.total)} in total.`}
          >
            {activity.weeks.map((week) =>
              week.map((day) => (
                <span class:list={["cell", day ? `l${day.level}` : "empty"]} title={day?.date} />
              ))
            )}
          </div>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-quiet dark:text-quiet-lifted">
            <span>
              {fmt(activity.total)} contributions · {fmt(activity.activeDays)} active days
              {activity.streak > 1 && <> · {activity.streak}-day streak</>}
            </span>
            <span class="flex items-center gap-1" aria-hidden="true">
              Less
              <span class="cell l0 legend" />
              <span class="cell l1 legend" />
              <span class="cell l2 legend" />
              <span class="cell l3 legend" />
              <span class="cell l4 legend" />
              More
            </span>
          </div>
          <a href="https://github.com/airton" target="_blank" rel="me noopener noreferrer" class="quiet-link inline-block mt-4 text-sm">
            github.com/airton →
          </a>
        </section>
      )
    }

    <!-- Writing -->
    <section class="mb-14">
      <h2 class="term-title"><span aria-hidden="true">~/</span>writing</h2>
      <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group flex items-baseline justify-between gap-4 py-2.5">
                <span class="text-base group-hover:underline underline-offset-4">{post.data.title}</span>
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-xs text-quiet dark:text-quiet-lifted shrink-0 tabular-nums"
                >
                  {formatDate(post.data.date)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/blog/" class="quiet-link inline-block mt-4 text-sm">All posts →</a>
    </section>

    <!-- Work with me -->
    <section class="mb-16">
      <h2 class="term-title"><span aria-hidden="true">~/</span>work-with-me</h2>
      <ul class="space-y-2 text-base text-ink-secondary dark:text-quiet-lifted">
        <li><a href="/zero-downtime/" class="quiet-link">Zero Downtime</a> — blue-green deploys and high availability on AWS.</li>
        <li><a href="/previas/" class="quiet-link">Business websites</a> — see live previews before you decide.</li>
        <li><a href="/contato/" class="quiet-link">Contact</a> — projects, partnerships or consulting.</li>
      </ul>
    </section>

    <MinimalFooter />
  </main>

</Layout>

<style>
  @reference "../styles/global.css";


  /* Contribution heatmap: one column per week, cells sized by the container so
     the full year always fits without scrolling. */
  .activity-grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    gap: 2px;
  }
  .cell {
    @apply block aspect-square rounded-[2px];
  }
  .cell.legend {
    @apply w-2.5 h-2.5;
  }
  .cell.empty {
    @apply bg-transparent;
  }
  .cell.l0 { @apply bg-hairline-faint; }
  .cell.l1 { @apply bg-brand/25; }
  .cell.l2 { @apply bg-brand/50; }
  .cell.l3 { @apply bg-brand/75; }
  .cell.l4 { @apply bg-brand; }
  :global(.dark) .cell.l0 { @apply bg-night-edge; }
  :global(.dark) .cell.l1 { @apply bg-brand-lifted/25; }
  :global(.dark) .cell.l2 { @apply bg-brand-lifted/50; }
  :global(.dark) .cell.l3 { @apply bg-brand-lifted/75; }
  :global(.dark) .cell.l4 { @apply bg-brand-lifted; }
</style>

---
/*
  Shell for the standard inner pages (projects, plugins, zero downtime, blog
  posts and tags, plugin and project pages, previews): the paper-theme frame
  from SiteShell, a way back, a big heading and a centred reading column.
*/
import Layout from "../layouts/Layout.astro";
import SiteShell from "./SiteShell.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  subheading?: string;
  lang?: string;
  alternates?: { hreflang: string; path: string }[];
  backLabel?: string;
  backHref?: string;
  noindex?: boolean;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
  modifiedDate?: Date;
}

const {
  title,
  description,
  heading,
  subheading,
  lang = "en",
  alternates,
  backLabel = "← Home",
  backHref = "/",
  noindex = false,
  image = "/og-home.png",
  type,
  publishedDate,
  modifiedDate,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  alternates={alternates}
  noindex={noindex}
  image={image}
  type={type}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  minimalNav={true}
  hideFooter={true}
>
  <slot name="head" />
  <SiteShell>
    <main class="pc-page">
      <a href={backHref} class="pc-back">{backLabel}</a>

      <header class="pc-pagehead">
        <div class="flex items-center gap-4">
          <slot name="icon" />
          <div class="min-w-0">
            <h1 class="pc-title">{heading}</h1>
            {subheading && <p class="pc-subtitle">{subheading}</p>}
            <slot name="subheading" />
          </div>
        </div>
        <slot name="header" />
      </header>

      <slot />
    </main>
  </SiteShell>
</Layout>

---
/*
  Shell for the minimal pages (privacy, contact, projects, plugins, zero
  downtime, blog posts, plugin pages): the narrow Plex column, a way back home, a two-line header and the
  one-line footer. The home and /sobre predate it and lay out their own header.
*/
import Layout from "../layouts/Layout.astro";
import MinimalFooter from "./MinimalFooter.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  subheading?: string;
  lang?: string;
  alternates?: { hreflang: string; path: string }[];
  backLabel?: string;
  backHref?: string;
  noindex?: boolean;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
  modifiedDate?: Date;
}

const {
  title,
  description,
  heading,
  subheading,
  lang = "en",
  alternates,
  backLabel = "← Home",
  backHref = "/",
  noindex = false,
  image = "/og-home.png",
  type,
  publishedDate,
  modifiedDate,
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  lang={lang}
  alternates={alternates}
  noindex={noindex}
  image={image}
  type={type}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  minimalNav={true}
  hideFooter={true}
>
  <slot name="head" />
  <main class="font-plex mx-auto w-full max-w-2xl px-4 sm:px-6 py-16 sm:py-24 text-ink dark:text-gallery-floor">
    <a href={backHref} class="text-sm text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor transition-colors">
      {backLabel}
    </a>

    <header class="mt-10 mb-14">
      <div class="flex items-center gap-3">
        <slot name="icon" />
        <div class="min-w-0">
          <h1 class="font-plex text-xl font-semibold tracking-tight">{heading}</h1>
          {subheading && <p class="text-sm text-quiet dark:text-quiet-lifted">{subheading}</p>}
          <slot name="subheading" />
        </div>
      </div>
      <slot name="header" />
    </header>

    <slot />

    <MinimalFooter />
  </main>
</Layout>

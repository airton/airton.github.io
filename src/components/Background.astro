---
/**
 * Interactive lattice behind the Zero Downtime CTA.
 *
 * The grid itself is a repeating CSS gradient (zero DOM nodes). Lit cells come
 * from a small recycled pool positioned on pointer move, so the whole effect
 * costs ~12 nodes and one listener instead of 3,000 divs each carrying its own
 * mouseenter handler. This renders on every article page, so the difference is
 * not academic.
 */
const CELL = 32;
const POOL = 12;
---

<div class="zd-grid" aria-hidden="true" data-cell={CELL} data-pool={POOL}></div>

<style define:vars={{ cell: `${CELL}px` }}>
  .zd-grid {
    /* The lattice rule: Night Wall lifted just far enough off Night Floor to
       register as a grid without becoming a visible border. */
    --zd-line: color-mix(in oklab, var(--color-quiet) 22%, transparent);

    position: absolute;
    inset: 0;
    background-color: var(--color-night-floor);
    background-image:
      linear-gradient(to right, var(--zd-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--zd-line) 1px, transparent 1px);
    background-size: var(--cell) var(--cell);
    overflow: hidden;
  }

  .zd-grid :global(.zd-cell) {
    position: absolute;
    width: var(--cell);
    height: var(--cell);
    opacity: 0;
    pointer-events: none;
    transition: opacity 1s ease-out;
    will-change: opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .zd-grid :global(.zd-cell) {
      transition: opacity 0.01ms;
    }
  }
</style>

<script>
  // One accent, not a random four-hue rainbow. The trace the pointer leaves is
  // the brand mark; picking a colour at random per cell made it decoration.
  // Read from the token so a re-tone reaches this too — no raw hex here.
  const CELL_FILL = "color-mix(in oklab, var(--color-brand-lifted) 12%, transparent)";
  const CELL_EDGE = "inset 0 0 0 1px var(--color-brand-lifted)";

  document.querySelectorAll<HTMLElement>(".zd-grid").forEach((grid) => {
    const cell = Number(grid.dataset.cell) || 32;
    const poolSize = Number(grid.dataset.pool) || 12;

    const pool: HTMLElement[] = Array.from({ length: poolSize }, () => {
      const el = document.createElement("div");
      el.className = "zd-cell";
      grid.appendChild(el);
      return el;
    });

    let next = 0;
    let lastCol = -1;
    let lastRow = -1;
    let queued: { col: number; row: number } | null = null;
    let frame = 0;

    const light = ({ col, row }: { col: number; row: number }) => {
      const el = pool[next];
      next = (next + 1) % poolSize;

      el.style.transition = "none";
      el.style.left = `${col * cell}px`;
      el.style.top = `${row * cell}px`;
      el.style.background = CELL_FILL;
      el.style.boxShadow = CELL_EDGE;
      el.style.opacity = "1";

      // Two frames: one to commit the un-transitioned position, one to start
      // the fade. Without this the browser coalesces both and nothing animates.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          el.style.transition = "";
          el.style.opacity = "0";
        });
      });
    };

    const onMove = (event: PointerEvent) => {
      const rect = grid.getBoundingClientRect();
      const col = Math.floor((event.clientX - rect.left) / cell);
      const row = Math.floor((event.clientY - rect.top) / cell);
      if (col === lastCol && row === lastRow) return;
      lastCol = col;
      lastRow = row;

      // Coalesce to one paint per frame; pointermove can fire far more often.
      queued = { col, row };
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        if (queued) light(queued);
        queued = null;
      });
    };

    grid.addEventListener("pointermove", onMove, { passive: true });
  });
</script>

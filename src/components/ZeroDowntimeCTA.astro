---
import { Button } from "@/components/ui/button";
import { IconArrowRight, IconWashDrycleanOff } from "@tabler/icons-react";
import Background from "./Background.astro";

interface Props {
  /**
   * True when this block *is* the page it links to. It then owns the page's
   * only `h1` and drops the "Saiba mais" link, which would point at itself.
   */
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
const Heading = isPage ? "h1" : "h2";
---

<section
  class="relative overflow-hidden z-10 w-full py-20 md:py-22 lg:py-30 bg-ink flex justify-center"
>
  <Background />
  <div class="relative container px-4 md:px-6">
    <div
      class="flex flex-col lg:flex-row items-center justify-center gap-4 space-y-4 text-center"
    >
      <div class="flex flex-col items-center space-y-4 text-center">
        <div class="space-y-4">
          <IconWashDrycleanOff
            className="w-[90px] h-[90px] lg:w-[120px] lg:h-[120px] text-wall mx-auto"
          />

          <Heading
            class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl lg:text-6xl/none text-wall"
          >
            Front End Zero Downtime
          </Heading>
          <p
            class="mx-auto max-w-[700px] text-quiet-lifted md:text-xl dark:text-quiet-lifted"
          >
            Garanta que suas aplicações Web estejam sempre disponíveis, sem
            interrupções, sem perda de receita.
          </p>
        </div>
        {
          !isPage && (
            <div class="w-full max-w-sm space-y-2 justify-end">
              <a href="/zero-downtime">
                <Button
                  className="w-full bg-wall text-ink-secondary hover:bg-hairline-faint"
                  size="lg"
                >
                  Saiba mais
                  <IconArrowRight className="ml-2 h-5 w-5" />
                </Button>
              </a>
              <p class="text-xs text-quiet-lifted dark:text-quiet-lifted">
                Disponível por tempo limitado.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

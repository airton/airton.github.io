---
/**
 * HeroHeadline - Modern, minimalist headline section
 * Elegant aurora wave animation background
 */
---

<section class="hero-headline">
  <!-- Aurora wave animated background -->
  <div class="hero-bg" aria-hidden="true">
    <!-- Morphing gradient blobs -->
    <div class="aurora">
      <div class="aurora-layer aurora-layer--1"></div>
      <div class="aurora-layer aurora-layer--2"></div>
      <div class="aurora-layer aurora-layer--3"></div>
    </div>

    <!-- Subtle particle dots -->
    <div class="particles">
      <div
        class="particle"
        style="--x: 10%; --y: 20%; --size: 3px; --duration: 20s; --delay: 0s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 85%; --y: 15%; --size: 2px; --duration: 25s; --delay: 2s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 25%; --y: 70%; --size: 2px; --duration: 22s; --delay: 5s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 75%; --y: 65%; --size: 3px; --duration: 18s; --delay: 3s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 50%; --y: 30%; --size: 2px; --duration: 24s; --delay: 1s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 90%; --y: 50%; --size: 2px; --duration: 21s; --delay: 4s;"
      >
      </div>
      <div
        class="particle"
        style="--x: 15%; --y: 45%; --size: 3px; --duration: 23s; --delay: 6s;"
      >
      </div>
    </div>

    <!-- Noise texture overlay -->
    <div class="noise-overlay"></div>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <!-- Eyebrow text -->
      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        Software Engineer
      </span>

      <!-- Main headline with animated text -->
      <h1 class="hero-title">
        Transformando ideias em
        <span class="hero-title-highlight">
          <span class="hero-title-gradient">experiências digitais</span>
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-subtitle">
        +15 anos criando soluções que importam.
        <span class="hero-subtitle-emphasis"
          >Código limpo. Performance. Resultados.</span
        >
      </p>

      <!-- CTA buttons -->
      <div class="hero-cta">
        <a href="#projects" class="hero-btn hero-btn--primary">
          Ver Projetos
          <svg
            class="hero-btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="/contato" class="hero-btn hero-btn--secondary">
          Vamos conversar
        </a>
      </div>

      <!-- Tech stack badges -->
      <div class="hero-stack">
        <span class="hero-stack-label">Stack atual:</span>
        <div class="hero-stack-items">
          <span class="hero-stack-badge">React</span>
          <span class="hero-stack-badge">TypeScript</span>
          <span class="hero-stack-badge">Node.js</span>
          <span class="hero-stack-badge">Go</span>
          <span class="hero-stack-badge">Python</span>
          <span class="hero-stack-badge">WordPress</span>
          <span class="hero-stack-badge">AWS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-headline {
    /*
      The aurora, the particles, the gradient headline and the primary pill all
      draw from these two hues only — the luminous indigo DESIGN.md reserves for
      hero atmosphere, and the violet that terminates its gradients. Keeping the
      field to a two-hue span is what holds the One Indigo Rule at the one place
      on the site allowed to glow.
    */
    --aurora-indigo: var(--color-indigo-accent-bright);
    --aurora-violet: var(--color-accent-violet);

    position: relative;
    min-height: calc(100vh - 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;
    background: linear-gradient(
      180deg,
      var(--color-gallery-floor) 0%,
      var(--color-hairline-faint) 100%
    );
  }

  :global(.dark) .hero-headline {
    background: linear-gradient(
      180deg,
      var(--color-night-floor) 0%,
      var(--color-night-wall) 100%
    );
  }

  /* Aurora Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .aurora {
    position: absolute;
    inset: -50%;
    width: 200%;
    height: 200%;
  }

  .aurora-layer {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
    mix-blend-mode: normal;
  }

  /* First blob - large, slow moving */
  .aurora-layer--1 {
    width: 60%;
    height: 60%;
    top: -10%;
    right: -15%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-indigo) 25%, transparent) 0%,
      color-mix(in oklab, var(--aurora-violet) 15%, transparent) 40%,
      transparent 70%
    );
    animation: auroraMove1 15s ease-in-out infinite;
  }

  /* Second blob - medium, diagonal */
  .aurora-layer--2 {
    width: 50%;
    height: 50%;
    bottom: -5%;
    left: -10%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-violet) 20%, transparent) 0%,
      color-mix(in oklab, var(--aurora-indigo) 10%, transparent) 50%,
      transparent 70%
    );
    animation: auroraMove2 18s ease-in-out infinite;
  }

  /* Third blob - smaller, accent */
  .aurora-layer--3 {
    width: 40%;
    height: 40%;
    top: 30%;
    left: 30%;
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-indigo) 15%, transparent) 0%,
      color-mix(in oklab, var(--aurora-violet) 10%, transparent) 50%,
      transparent 70%
    );
    animation: auroraMove3 12s ease-in-out infinite;
  }

  /*
    Dark mode keeps the same two hues and only raises their strength — the
    aurora reads as the same light source dimmed up, not a different palette.
  */
  :global(.dark) .aurora-layer {
    opacity: 0.7;
  }

  :global(.dark) .aurora-layer--1 {
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-indigo) 35%, transparent) 0%,
      color-mix(in oklab, var(--aurora-violet) 20%, transparent) 40%,
      transparent 70%
    );
  }

  :global(.dark) .aurora-layer--2 {
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-violet) 30%, transparent) 0%,
      color-mix(in oklab, var(--aurora-indigo) 15%, transparent) 50%,
      transparent 70%
    );
  }

  :global(.dark) .aurora-layer--3 {
    background: radial-gradient(
      ellipse,
      color-mix(in oklab, var(--aurora-indigo) 25%, transparent) 0%,
      color-mix(in oklab, var(--aurora-violet) 15%, transparent) 50%,
      transparent 70%
    );
  }

  @keyframes auroraMove1 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    25% {
      transform: translate(-5%, 8%) rotate(5deg) scale(1.05);
    }
    50% {
      transform: translate(-10%, 5%) rotate(-3deg) scale(0.95);
    }
    75% {
      transform: translate(-3%, -5%) rotate(2deg) scale(1.02);
    }
  }

  @keyframes auroraMove2 {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    33% {
      transform: translate(8%, -6%) rotate(-5deg) scale(1.08);
    }
    66% {
      transform: translate(5%, 8%) rotate(3deg) scale(0.92);
    }
  }

  @keyframes auroraMove3 {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(15%, -10%) scale(1.1);
    }
  }

  /* Floating particles */
  .particles {
    position: absolute;
    inset: 0;
  }

  .particle {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--size);
    height: var(--size);
    background: var(--aurora-indigo);
    border-radius: 50%;
    opacity: 0.4;
    animation: particleFloat var(--duration) ease-in-out infinite;
    animation-delay: var(--delay);
  }

  :global(.dark) .particle {
    background: var(--color-indigo-accent-lifted);
    opacity: 0.5;
  }

  @keyframes particleFloat {
    0%,
    100% {
      transform: translate(0, 0);
      opacity: 0.4;
    }
    25% {
      transform: translate(10px, -20px);
      opacity: 0.6;
    }
    50% {
      transform: translate(-5px, -35px);
      opacity: 0.3;
    }
    75% {
      transform: translate(15px, -15px);
      opacity: 0.5;
    }
  }

  /* Noise texture */
  .noise-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  :global(.dark) .noise-overlay {
    opacity: 0.05;
  }

  .hero-container {
    position: relative;
    max-width: 72rem;
    margin: 0 auto;
    width: 100%;
    z-index: 10;
  }

  .hero-content {
    position: relative;
    text-align: center;
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    /* Indigo Accent, not the bright variant: indigo-500 on this near-white
       ground computes 4.07:1 and fails AA for text this size. */
    color: var(--color-indigo-accent);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.6s ease-out;
  }

  :global(.dark) .hero-eyebrow {
    color: var(--color-indigo-accent-lifted);
  }

  .hero-eyebrow-dot {
    width: 8px;
    height: 8px;
    background: var(--color-live-signal);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
    box-shadow: 0 0 10px
      color-mix(in oklab, var(--color-live-signal) 50%, transparent);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.15);
    }
  }

  /* Main title */
  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  :global(.dark) .hero-title {
    color: var(--color-gallery-floor);
  }

  .hero-title-highlight {
    display: block;
    margin-top: 0.25rem;
  }

  /*
    The one gradient text in the system. DESIGN.md assigns the hero headline to
    Indigo Accent Bright, so the ramp spans only that indigo to the accent
    violet — the previous purple-to-pink run introduced two hues the palette
    does not contain. The solid indigo underneath is what shows if
    background-clip: text is unsupported, so the headline is never invisible.
  */
  .hero-title-gradient {
    color: var(--aurora-indigo);
    background: linear-gradient(
      135deg,
      var(--aurora-indigo) 0%,
      var(--aurora-violet) 100%
    );
    background-size: 200% 200%;
    animation: gradientShift 5s ease infinite;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .hero-title-gradient {
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Subtitle */
  /* The Deck role: 1.125rem / 1.6 in Quiet. Previously ran to 1.375rem, a step
     the type ramp does not define. */
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-quiet);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  :global(.dark) .hero-subtitle {
    color: var(--color-quiet-faint);
  }

  .hero-subtitle-emphasis {
    display: block;
    font-weight: 600;
    color: var(--color-ink-secondary);
    margin-top: 0.5rem;
  }

  :global(.dark) .hero-subtitle-emphasis {
    color: var(--color-quiet-lifted);
  }

  /* CTA Buttons */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    /* Label role — the control-text step, same as the nav links. */
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .hero-btn--primary {
    background: linear-gradient(
      135deg,
      var(--aurora-indigo) 0%,
      var(--aurora-violet) 100%
    );
    color: var(--color-wall);
    box-shadow: 0 4px 20px
      color-mix(in oklab, var(--aurora-indigo) 40%, transparent);
  }

  .hero-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px
      color-mix(in oklab, var(--aurora-indigo) 50%, transparent);
  }

  .hero-btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .hero-btn--primary:hover .hero-btn-icon {
    transform: translateX(4px);
  }

  .hero-btn--secondary {
    background: color-mix(in oklab, var(--color-wall) 80%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-ink-secondary);
    border: 1px solid color-mix(in oklab, var(--color-ink) 8%, transparent);
  }

  :global(.dark) .hero-btn--secondary {
    background: color-mix(in oklab, var(--color-wall) 10%, transparent);
    color: var(--color-quiet-lifted);
    border-color: color-mix(in oklab, var(--color-wall) 10%, transparent);
  }

  .hero-btn--secondary:hover {
    background: color-mix(in oklab, var(--color-wall) 95%, transparent);
    transform: translateY(-2px);
  }

  :global(.dark) .hero-btn--secondary:hover {
    background: color-mix(in oklab, var(--color-wall) 15%, transparent);
  }

  /* Tech stack */
  .hero-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    animation: fadeInUp 0.6s ease-out 0.4s both;
  }

  /* Micro role. Was slate-400, which is 2.63:1 here — below AA on any light
     ground. Quiet carries it at 4.6:1; the slate-400 step returns in dark mode,
     where DESIGN.md records it at 6.8:1 over a night surface. */
  .hero-stack-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-quiet);
  }

  :global(.dark) .hero-stack-label {
    color: var(--color-quiet-faint);
  }

  .hero-stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  /*
    The lit chip variant. Micro type, and Indigo Accent rather than the bright
    variant — indigo-500 over this translucent white reads 4.07:1, Accent reads
    6.5:1. Casing is left alone so "TypeScript" and "Node.js" keep their own.
  */
  .hero-stack-badge {
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    background: color-mix(in oklab, var(--color-wall) 70%, transparent);
    backdrop-filter: blur(10px);
    color: var(--color-indigo-accent);
    border-radius: 9999px;
    border: 1px solid
      color-mix(in oklab, var(--aurora-indigo) 15%, transparent);
    transition: all 0.2s ease;
  }

  :global(.dark) .hero-stack-badge {
    background: color-mix(in oklab, var(--aurora-indigo) 15%, transparent);
    color: var(--color-indigo-accent-lifted);
    border-color: color-mix(in oklab, var(--aurora-indigo) 25%, transparent);
  }

  .hero-stack-badge:hover {
    background: color-mix(in oklab, var(--aurora-indigo) 10%, transparent);
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--aurora-indigo) 30%, transparent);
  }

  :global(.dark) .hero-stack-badge:hover {
    background: color-mix(in oklab, var(--aurora-indigo) 25%, transparent);
  }

  /* Fade in animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /*
    The hero runs six infinite animations. Rather than kill them outright —
    which would strip the entrance hierarchy and leave the aurora as flat
    blocks — hold each one at a composed position: the blobs stay where their
    keyframes place them, the gradient headline keeps its colour, the status
    dot keeps its glow, and the staggered entrance resolves immediately.
  */
  @media (prefers-reduced-motion: reduce) {
    .aurora-layer--1 {
      transform: translate(-5%, 8%) rotate(5deg) scale(1.05);
    }

    .aurora-layer--2 {
      transform: translate(8%, -6%) rotate(-5deg) scale(1.08);
    }

    .aurora-layer--3 {
      transform: translate(15%, -10%) scale(1.1);
    }

    .aurora-layer,
    .particle,
    .hero-eyebrow-dot,
    .hero-title-gradient,
    .hero-eyebrow,
    .hero-title,
    .hero-subtitle,
    .hero-cta,
    .hero-stack {
      animation: none;
    }

    .hero-title-gradient {
      background-position: 50% 50%;
    }

    /* The entrance keyframes end at full opacity; without them the content
       would otherwise inherit `both` fill and stay invisible. */
    .hero-eyebrow,
    .hero-title,
    .hero-subtitle,
    .hero-cta,
    .hero-stack {
      opacity: 1;
      transform: none;
    }

    .particle {
      opacity: 0.4;
    }

    .hero-btn,
    .hero-btn-icon,
    .hero-stack-badge {
      transition-duration: 0.01ms;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .hero-headline {
      min-height: calc(100vh - 4rem);
      padding: 5rem 1rem 3rem;
    }

    .hero-cta {
      flex-direction: column;
      align-items: center;
    }

    .hero-btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }

    .aurora-layer {
      filter: blur(60px);
    }
  }
</style>

---
/**
 * HeroHeadline — the site's one Display headline.
 *
 * What used to be here: three morphing aurora blobs, seven floating particles,
 * an animated indigo→violet gradient on the headline text, and a gradient pill
 * carrying a coloured glow. All of it is gone. That composition is the reason
 * the site read as generic AI marketing, and none of it was carrying meaning —
 * it was atmosphere standing in for a point of view.
 *
 * What replaces it is the room itself: warm ink on a white wall, one flat
 * accent, and a single authored moment — the eyebrow, headline, deck, CTAs and
 * stack arriving in sequence, once, on load. Everything else is still.
 */
---

<section class="hero-headline">
  <div class="hero-container">
    <div class="hero-content">
      <span class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        Software Engineer
      </span>

      <h1 class="hero-title">
        Transformando ideias em
        <span class="hero-title-highlight">experiências digitais</span>
      </h1>

      <p class="hero-subtitle">
        +15 anos criando soluções que importam.
        <span class="hero-subtitle-emphasis"
          >Código limpo. Performance. Resultados.</span
        >
      </p>

      <div class="hero-cta">
        <a href="#projects" class="hero-btn hero-btn--primary">
          Ver Projetos
          <svg
            class="hero-btn-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="/contato" class="hero-btn hero-btn--secondary">
          Vamos conversar
        </a>
      </div>

      <div class="hero-stack">
        <span class="hero-stack-label">Stack atual:</span>
        <div class="hero-stack-items">
          <span class="hero-stack-badge">React</span>
          <span class="hero-stack-badge">TypeScript</span>
          <span class="hero-stack-badge">Node.js</span>
          <span class="hero-stack-badge">Go</span>
          <span class="hero-stack-badge">Python</span>
          <span class="hero-stack-badge">WordPress</span>
          <span class="hero-stack-badge">AWS</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-headline {
    position: relative;
    min-height: calc(100vh - 5rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 4rem;
    /* A flat wall. The section used to carry a two-stop gradient; a room lit
       evenly is what lets the type be the only event in the viewport. */
    background: var(--color-wall);
    border-bottom: 1px solid var(--color-hairline);
  }

  :global(.dark) .hero-headline {
    background: var(--color-night-wall);
    border-bottom-color: var(--color-night-edge);
  }

  .hero-container {
    max-width: 72rem;
    margin: 0 auto;
    width: 100%;
  }

  /* Left-aligned from `md` up, matching the showcase sections below it, and
     centred only where a single narrow column has nowhere else to go. */
  .hero-content {
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-content {
      text-align: left;
    }
  }

  /* Eyebrow */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand); /* 5.17:1 on Wall */
    margin-bottom: 1.5rem;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(.dark) .hero-eyebrow {
    color: var(--color-brand-lifted); /* 7.38:1 on Night Wall */
  }

  /* The availability signal. A fill, never text — 3.30:1. */
  .hero-eyebrow-dot {
    width: 7px;
    height: 7px;
    background: var(--color-live-signal);
    border-radius: 50%;
  }

  /* Display role. */
  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 20ch;
    margin-bottom: 1.5rem;
    text-wrap: balance;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
  }

  :global(.dark) .hero-title {
    color: var(--color-gallery-floor);
  }

  @media (min-width: 768px) {
    .hero-title {
      text-wrap: pretty;
    }
  }

  /*
    The old gradient span. Emphasis now comes from the line break and the
    accent underline that draws itself once on load — a mark made under the
    phrase rather than a colour poured into it.
  */
  .hero-title-highlight {
    display: block;
    position: relative;
    width: fit-content;
    margin-top: 0.25rem;
  }

  @media (max-width: 767px) {
    .hero-title-highlight {
      margin-inline: auto;
    }
  }

  .hero-title-highlight::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1em;
    height: 3px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    animation: drawRule 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both;
  }

  :global(.dark) .hero-title-highlight::after {
    background: var(--color-brand-lifted);
  }

  /* Deck role: 1.125rem / 1.6 in Quiet. */
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--color-quiet);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      margin-inline: 0;
    }
  }

  :global(.dark) .hero-subtitle {
    color: var(--color-quiet-faint);
  }

  .hero-subtitle-emphasis {
    display: block;
    font-weight: 600;
    color: var(--color-ink-secondary);
    margin-top: 0.5rem;
  }

  :global(.dark) .hero-subtitle-emphasis {
    color: var(--color-quiet-lifted);
  }

  /* CTA Buttons */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 3rem;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.24s both;
  }

  @media (min-width: 768px) {
    .hero-cta {
      justify-content: flex-start;
    }
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .hero-btn:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  /*
    Flat accent, no gradient and no coloured halo. The shadow is the room's
    own tinted shadow, so the button sits on the wall like everything else.
  */
  .hero-btn--primary {
    background: var(--color-brand);
    color: var(--color-wall); /* 5.17:1 */
    box-shadow: var(--shadow-resting);
  }

  .hero-btn--primary:hover {
    background: var(--color-brand-deep); /* 6.70:1 */
    transform: translateY(-2px);
    box-shadow: var(--shadow-approach);
  }

  .hero-btn-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .hero-btn--primary:hover .hero-btn-icon {
    transform: translateX(4px);
  }

  .hero-btn--secondary {
    background: var(--color-wall);
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-hairline);
  }

  :global(.dark) .hero-btn--secondary {
    background: transparent;
    color: var(--color-quiet-lifted);
    border-color: var(--color-night-edge);
  }

  .hero-btn--secondary:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  :global(.dark) .hero-btn--secondary:hover {
    border-color: var(--color-quiet-faint);
  }

  /* Tech stack */
  .hero-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    animation: riseIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
  }

  @media (min-width: 768px) {
    .hero-stack {
      align-items: flex-start;
    }
  }

  /* Micro role in Quiet — 5.15:1. */
  .hero-stack-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-quiet);
  }

  :global(.dark) .hero-stack-label {
    color: var(--color-quiet-faint);
  }

  .hero-stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-stack-items {
      justify-content: flex-start;
    }
  }

  /*
    Chip spec: pale ground, dark text — metadata recedes through its ground,
    never through faded ink. Ink Secondary on Hairline Faint is 9.48:1.
  */
  .hero-stack-badge {
    padding: 0.375rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--color-hairline-faint);
    color: var(--color-ink-secondary);
    border-radius: 9999px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  :global(.dark) .hero-stack-badge {
    background: var(--color-night-edge);
    color: var(--color-quiet-lifted);
  }

  .hero-stack-badge:hover {
    background: var(--color-brand-wash);
    color: var(--color-brand-deep); /* 5.49:1 on the wash */
  }

  :global(.dark) .hero-stack-badge:hover {
    background: var(--color-night-edge);
    color: var(--color-brand-lifted);
  }

  /*
    The one authored moment: content rises into place once, on load, on an
    exponential ease-out from an already-composed layout. Nothing loops.
  */
  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes drawRule {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /*
    With motion reduced there is nothing left to hold in place — the entrance
    is the only animation in the section. Everything resolves to its composed
    state immediately.
  */
  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-subtitle,
    .hero-cta,
    .hero-stack {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero-title-highlight::after {
      animation: none;
      transform: scaleX(1);
    }

    .hero-btn,
    .hero-btn-icon,
    .hero-stack-badge {
      transition-duration: 0.01ms;
    }
  }

  @media (max-width: 640px) {
    .hero-headline {
      min-height: calc(100vh - 4rem);
      padding: 5rem 1rem 3rem;
    }

    .hero-cta {
      flex-direction: column;
      align-items: center;
    }

    .hero-btn {
      width: 100%;
      max-width: 280px;
      justify-content: center;
    }
  }
</style>

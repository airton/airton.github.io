---
import { Card, CardContent } from "@/components/ui/card";
import { IconCode, IconArrowRight, IconExternalLink } from "@tabler/icons-react";
import { projects } from "../data/projects";
import { Image } from "astro:assets";
---

<section
  id="projects"
  class="w-full py-24 md:py-32 bg-wall flex justify-center"
>
  <div class="container px-4 md:px-6 max-w-7xl">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6 text-left">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-brand font-medium text-sm tracking-wider uppercase mb-3 text-left">
          <IconCode className="w-4 h-4" />
          Trabalhos em Destaque
        </div>
        <h2 class="text-4xl md:text-6xl font-bold tracking-tight text-ink mb-6 leading-[1.1]">
          Alguns cases de sucesso e projetos de código aberto.
        </h2>
        <p class="text-lg text-quiet font-serif italic text-left">
          Uma coleção de produtos digitais e iniciativas open-source construídos com precisão e tecnologia moderna.
        </p>
      </div>
      <div class="hidden md:block">
        <p class="text-quiet text-sm max-w-[200px] text-right">
          Demonstrando expertise em desenvolvimento full-stack e design de UI/UX.
        </p>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        projects.map(({ name, desc, slug, image }) => (
          <a href={`/project/${slug}`} class="group block h-full">
            <Card className="h-full bg-wall border-transparent shadow-resting hover:shadow-approach group-hover:-translate-y-2 transition-all duration-500 rounded-[2rem] overflow-hidden flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <Image
                  src={image}
                  alt={`Preview do projeto ${name}`}
                  class="w-full h-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
                  width={800}
                  height={500}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink/40 via-transparent to-transparent opacity-60 group-hover:opacity-20 transition-opacity duration-700"></div>
              </div>
              
              <CardContent className="p-8 flex-grow flex flex-col">
                <div class="flex items-center justify-between mb-4">
                  <h3 class="text-2xl font-bold text-ink group-hover:text-brand transition-colors duration-300">
                    {name}
                  </h3>
                  <div class="p-2 bg-hairline-faint rounded-full text-ink-secondary group-hover:bg-brand-wash group-hover:text-brand transition-all duration-300 transform group-hover:rotate-12">
                    <IconExternalLink className="w-5 h-5" />
                  </div>
                </div>
                
                <p class="text-quiet text-sm leading-relaxed line-clamp-2 mb-8 flex-grow">
                  {desc}
                </p>
                
                <!-- Footer -->
                <div class="flex items-center text-sm font-bold text-ink mt-auto tracking-tight uppercase">
                  <span class="mr-2">Case Study</span>
                  <div class="h-px flex-grow bg-hairline-faint mx-4 group-hover:bg-brand-edge transition-colors"></div>
                  <IconArrowRight className="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300 text-brand-bright" />
                </div>
              </CardContent>
            </Card>
          </a>
        ))
      }
    </div>
  </div>
</section>

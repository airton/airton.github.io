---
/*
  The projects as a ruled card of rows, used on /projetos (links to the case
  studies) and anywhere else that wants them linked to the live sites.
*/
import { Image } from "astro:assets";
import { projects, BUILDING } from "../data/projects";

interface Props {
  linkTo?: "site" | "case";
}

const { linkTo = "site" } = Astro.props;

// One line per project — the long `desc` in projects.ts is written (in
// Portuguese) for the case-study page and is too heavy for a grid cell.
const projectHooks: Record<string, string> = {
  declone: "Finds fake and cloned copies of your site on lookalike domains.",
  "lume-iq": "Free online IQ test with IRT scoring and a margin of error.",
  jurosobra: "Interest simulator for off-plan home financing in Brazil.",
  balancewise: "Smart investment portfolio rebalancing.",
  timberoad: "Solar sizing calculators and planning tools for vanlife.",
  "pablo-escobar-ipsum": "Lorem Ipsum, Narcos edition.",
};

const domainOf = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const external = linkTo === "site" ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<div class="pc-card">
  <div class="pc-thead"><span>Project</span><span>Status</span></div>
  <ul>
    {
      projects.map((p) => (
        <li>
          <a href={linkTo === "site" ? p.link : `/project/${p.slug}/`} {...external} class="pc-row">
            <Image src={p.logo} alt="" width={84} height={84} class="pc-mark" />
            <div class="min-w-0 flex-1">
              <span class="pc-row-title">{p.name}</span>
              <p class="pc-row-desc">{projectHooks[p.slug] ?? p.desc}</p>
              <span class="pc-meta mt-1.5 inline-block">{domainOf(p.link)}</span>
            </div>
            {BUILDING.has(p.slug) ? (
              <span class="pc-badge shrink-0">Building</span>
            ) : (
              <span class="pc-meta shrink-0">Live</span>
            )}
          </a>
        </li>
      ))
    }
    <li>
      <a href="/en/gemini-flow-downloader/" class="pc-row">
        <span class="pc-mark">G</span>
        <div class="min-w-0 flex-1">
          <span class="pc-row-title">Gemini Flow Downloader</span>
          <p class="pc-row-desc">Export Gemini chats to Markdown or JSON.</p>
          <span class="pc-meta mt-1.5 inline-block">Chrome extension</span>
        </div>
        <span class="pc-meta shrink-0">Live</span>
      </a>
    </li>
  </ul>
</div>

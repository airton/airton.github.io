---
/*
  The plugins listing, in one language. Each language has its own route
  (/plugins/ and /en/plugins/) so a crawler sees one honest `lang` per URL;
  the pages link to each other instead of swapping text client-side.
*/
import MinimalPage from "./MinimalPage.astro";
import PluginList from "./PluginList.astro";

interface Props {
  lang: "en" | "pt";
}

const { lang } = Astro.props;

const alternates = [
  { hreflang: "pt-BR", path: "/plugins/" },
  { hreflang: "en", path: "/en/plugins/" },
  { hreflang: "x-default", path: "/plugins/" },
];

const COPY = {
  en: {
    title: "WordPress Plugins | Airton Vancin",
    description: "Free WordPress plugins by Airton Vancin: featured videos, user roles, AI SEO suggestions, JumpCloud SSO and more.",
    heading: "WordPress Plugins",
    subheading: "Free and open source, on WordPress.org",
    intro: "Plugins I've built for WordPress, each focused on one job. Pick one for features, installation and FAQ.",
    profile: "All on WordPress.org →",
    other: { label: "Português", href: "/plugins/", lang: "pt-BR" },
  },
  pt: {
    title: "Plugins WordPress | Airton Vancin",
    description: "Plugins WordPress gratuitos de Airton Vancin: vídeo destacado, papéis de usuário, sugestões de SEO com IA, SSO com JumpCloud e mais.",
    heading: "Plugins WordPress",
    subheading: "Gratuitos e open source, no WordPress.org",
    intro: "Plugins que criei para WordPress, cada um focado em uma tarefa. Escolha um para ver recursos, instalação e FAQ.",
    profile: "Todos no WordPress.org →",
    other: { label: "English", href: "/en/plugins/", lang: "en" },
  },
} as const;

const t = COPY[lang];
---

<MinimalPage
  title={t.title}
  description={t.description}
  heading={t.heading}
  subheading={t.subheading}
  lang={lang === "pt" ? "pt-BR" : "en"}
  alternates={alternates}
  backLabel={lang === "pt" ? "← Início" : "← Home"}
>
  <section class="mb-14 space-y-4 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
    <p>{t.intro}</p>
  </section>

  <section class="mb-16">
    <h2 class="term-title"><span aria-hidden="true">~/</span>plugins</h2>
    <PluginList lang={lang} />
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href="https://profiles.wordpress.org/airtonvancin/#content-plugins" target="_blank" rel="me noopener noreferrer" class="quiet-link">
        {t.profile}
      </a>
      <a href={t.other.href} hreflang={t.other.lang} class="quiet-link">{t.other.label}</a>
    </p>
  </section>
</MinimalPage>

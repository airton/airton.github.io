---
import type { MarkdownInstance } from "astro";
import LangBadge from "@/components/LangBadge.astro";

interface Props {
  posts: MarkdownInstance<Record<string, any>>[];
  title?: string;
}

const { posts, title = "Últimos Posts" } = Astro.props;

const langOf = (post: MarkdownInstance<Record<string, any>>) =>
  post.frontmatter.lang ?? "pt-BR";
---

<div class="w-full bg-wall py-12">
  <div class="container px-4 md:px-6 max-w-4xl mx-auto">
    <h2 class="text-2xl font-bold mb-6 text-ink">
      {title}
    </h2>
    <div class="grid gap-6">
      {
        posts.map((post) => (
          <a
            href={post.url}
            class="block p-4 border border-hairline rounded-lg hover:bg-gallery-floor transition-colors"
          >
            <div class="flex items-start gap-3 mb-2">
              <h3
                class="text-xl font-semibold text-ink"
                lang={langOf(post) === "pt-BR" ? undefined : langOf(post)}
              >
                {post.frontmatter.title}
              </h3>
              <LangBadge lang={langOf(post)} class="ml-auto mt-1" />
            </div>
            <p
              class="text-ink-secondary"
              lang={langOf(post) === "pt-BR" ? undefined : langOf(post)}
            >
              {post.frontmatter.description}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</div>

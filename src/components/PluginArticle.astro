---
/*
  One plugin page, in one language, on the minimal shell.

  Each language has its own route (/plugin/<slug>/ and /en/plugin/<slug>/) so a
  crawler sees one honest `lang` per URL; the two link to each other with a
  plain anchor in the header rather than swapping text client-side.
*/
import MinimalPage from "@/components/MinimalPage.astro";
import type { PluginData } from "@/data/plugins";
import { pluginJsonLd } from "@/helpers/pluginJsonLd";

interface Props {
  plugin: PluginData;
  lang: "en" | "pt";
}

const { plugin, lang } = Astro.props;

const LABELS = {
  en: {
    titleSuffix: "WordPress Plugin",
    back: "← Plugins",
    subheading: "WordPress plugin",
    download: "Download on WordPress.org →",
    other: { label: "Português", lang: "pt-BR" },
    premium_sub: "Monthly or annual plans available via Stripe.",
    upgrade: "Upgrade to Premium →",
    modal_title: "You're almost there",
    modal_desc:
      "Thanks for choosing my plugin. If you find it useful, consider supporting my work with a coffee. It helps me keep building and maintaining open-source tools.",
    modal_continue: "Continue to download →",
    modal_maybe: "Maybe later",
    video_unsupported: "Your browser does not support the video tag.",
  },
  pt: {
    titleSuffix: "Plugin WordPress",
    back: "← Plugins",
    subheading: "Plugin WordPress",
    download: "Baixar no WordPress.org →",
    other: { label: "English", lang: "en" },
    premium_sub: "Planos mensais ou anuais disponíveis via Stripe.",
    upgrade: "Mudar para Premium →",
    modal_title: "Você está quase lá",
    modal_desc:
      "Obrigado por escolher meu plugin. Se ele for útil, considere apoiar meu trabalho com um café. Isso me ajuda a continuar construindo e mantendo ferramentas open source.",
    modal_continue: "Continuar para o download →",
    modal_maybe: "Talvez depois",
    video_unsupported: "Seu navegador não suporta o elemento de vídeo.",
  },
} as const;

const t = LABELS[lang];
const content = plugin[lang];

const ptPath = `/plugin/${plugin.slug}/`;
const enPath = `/en/plugin/${plugin.slug}/`;
const selfPath = lang === "en" ? enPath : ptPath;
const otherPath = lang === "en" ? ptPath : enPath;
const backHref = lang === "en" ? "/en/plugins/" : "/plugins/";

const metaDescription =
  lang === "en" ? (plugin.seoDescription ?? plugin.en.desc) : (plugin.seoDescriptionPt ?? plugin.pt.desc);

const jsonLd = pluginJsonLd({
  plugin,
  lang,
  description: metaDescription,
  url: new URL(selfPath, Astro.site).href,
});

/*
  The FAQ section was previously guarded on `plugin.faq`, a field PluginData
  does not have — the copy is under `en`/`pt`. So the guard was always falsy
  and all 16 authored questions across four plugins never rendered.
*/
const faq = content.faq ?? [];
const body = "text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted";
---

<MinimalPage
  title={`${plugin.name} — ${t.titleSuffix} | Airton Vancin`}
  description={metaDescription}
  heading={plugin.name}
  subheading={t.subheading}
  lang={lang === "pt" ? "pt-BR" : "en"}
  alternates={[
    { hreflang: "pt-BR", path: ptPath },
    { hreflang: "en", path: enPath },
    { hreflang: "x-default", path: ptPath },
  ]}
  image={`https://ps.w.org/${plugin.slug}/assets/banner-772x250.png`}
  backLabel={t.back}
  backHref={backHref}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <Fragment slot="header">
    <p class="mt-6 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">{content.desc}</p>
    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
      <a href={plugin.link} target="_blank" rel="noopener noreferrer" class="quiet-link" data-download>
        {t.download}
      </a>
      <a href={otherPath} hreflang={t.other.lang} lang={t.other.lang} class="quiet-link">{t.other.label}</a>
    </p>
  </Fragment>

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>about</h2>
    <div class="prose post-body" set:html={content.fullDescription} />
  </section>

  {
    plugin.video && (
      <section class="mb-14">
        <h2 class="term-title"><span aria-hidden="true">~/</span>demo</h2>
        <video
          src={plugin.video}
          controls
          preload="metadata"
          class="w-full aspect-video rounded-md border border-hairline-faint dark:border-night-edge bg-ink"
        >
          {t.video_unsupported}
        </video>
      </section>
    )
  }

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>features</h2>
    <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
      {content.features.map((feature) => <li class={`py-2.5 ${body}`}>{feature}</li>)}
    </ul>
  </section>

  {
    content.premium && (
      <section class="mb-14">
        <h2 class="term-title"><span aria-hidden="true">~/</span>premium</h2>
        <div class={`space-y-4 ${body}`}>
          <p>{content.premium.description}</p>
          <ul class="divide-y divide-hairline-faint dark:divide-night-edge">
            {content.premium.features.map((feature) => (
              <li class="py-2.5">{feature}</li>
            ))}
          </ul>
          {content.premium.howToActivate && (
            <ol class="list-decimal pl-5 space-y-1.5">
              {content.premium.howToActivate.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
          )}
          <p class="text-sm text-quiet dark:text-quiet-lifted">{t.premium_sub}</p>
          <p class="text-sm">
            <a href={plugin.link} target="_blank" rel="noopener noreferrer" class="quiet-link">
              {t.upgrade}
            </a>
          </p>
        </div>
      </section>
    )
  }

  <section class="mb-14">
    <h2 class="term-title"><span aria-hidden="true">~/</span>installation</h2>
    <div class="prose post-body" set:html={content.installation} />
  </section>

  {
    faq.length > 0 && (
      <section class="mb-14">
        <h2 class="term-title"><span aria-hidden="true">~/</span>faq</h2>
        <dl class="divide-y divide-hairline-faint dark:divide-night-edge">
          {faq.map((item) => (
            <div class="py-4">
              <dt class="font-medium">{item.question}</dt>
              <dd class={`mt-1 ${body}`}>{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Buy Me a Coffee interstitial, shown before the WordPress.org download. -->
  <div id="bmc-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-ink/60 backdrop-blur-sm">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="bmc-modal-title"
      class="font-plex bg-wall dark:bg-night-wall w-full max-w-md rounded-lg border border-hairline dark:border-night-edge p-6 sm:p-8"
    >
      <h2 id="bmc-modal-title" class="text-base font-semibold">{t.modal_title}</h2>
      <p class={`mt-2 ${body}`}>{t.modal_desc}</p>
      <div class="mt-6">
        <a href="https://www.buymeacoffee.com/airton" target="_blank" rel="noopener noreferrer">
          <img
            src="https://cdn.buymeacoffee.com/buttons/v2/default-blue.png"
            alt="Buy Me A Coffee"
            width="217"
            height="60"
            loading="lazy"
          />
        </a>
      </div>
      <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        <button id="continue-download" type="button" class="quiet-link cursor-pointer">{t.modal_continue}</button>
        <button id="close-modal" type="button" class="text-quiet dark:text-quiet-lifted hover:text-ink dark:hover:text-gallery-floor cursor-pointer">
          {t.modal_maybe}
        </button>
      </p>
    </div>
  </div>
</MinimalPage>

<script is:inline>
  (function () {
    var modal = document.getElementById("bmc-modal");
    var continueBtn = document.getElementById("continue-download");
    var closeBtn = document.getElementById("close-modal");
    var downloads = document.querySelectorAll("a[data-download]");
    if (!modal || !downloads.length) return;

    var pluginUrl = downloads[0].getAttribute("href");

    function open() {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      continueBtn && continueBtn.focus();
    }
    function close() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    downloads.forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        open();
      });
    });

    continueBtn &&
      continueBtn.addEventListener("click", function () {
        window.open(pluginUrl, "_blank", "noopener");
        close();
      });
    closeBtn && closeBtn.addEventListener("click", close);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") close();
    });
  })();
</script>

<script
  data-name="BMC-Widget"
  data-cfasync="false"
  src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
  data-id="airton"
  data-description="Support me on Buy me a coffee!"
  data-message="Hi 👋!"
  data-color="#5F7FFF"
  data-position="Right"
  data-x_margin="18"
  data-y_margin="18"></script>

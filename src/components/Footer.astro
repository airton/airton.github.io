---
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandWordpress,
  IconMail,
  IconNews,
  IconArrowUp,
  IconArrowUpRight,
} from "@tabler/icons-react";
import { plugins } from "../data/plugins";
import { projects } from "../data/projects";

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    href: "https://github.com/airton",
    label: "GitHub",
    icon: IconBrandGithub,
  },
  {
    href: "https://linkedin.com/in/airtonvancin",
    label: "LinkedIn",
    icon: IconBrandLinkedin,
  },
  {
    href: "https://profiles.wordpress.org/airtonvancin/",
    label: "WordPress",
    icon: IconBrandWordpress,
  },
  {
    href: "mailto:airtonvancin@gmail.com",
    label: "Email",
    icon: IconMail,
    external: false,
  },
  {
    href: "https://nichesignal.substack.com/?utm_campaign=airtonvancin.com",
    label: "Substack",
    icon: IconNews,
  },
];

const siteLinks = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  { href: "/previas", label: "Prévias" },
  { href: "/sobre", label: "Sobre" },
  { href: "/contato", label: "Contato" },
  { href: "/zero-downtime", label: "Zero Downtime" },
];
---

<footer
  class="relative bg-gallery-floor dark:bg-night-floor border-t border-hairline dark:border-night-edge"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-bright/40 to-transparent"
  >
  </div>

  <div class="container mx-auto px-4 md:px-6 py-16 md:py-20">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-12 text-center md:text-left"
    >
      <div class="space-y-5 flex flex-col items-center md:items-start">
        <a href="/" class="font-bold text-xl tracking-tight text-ink dark:text-gallery-floor">
          Airton Vancin
        </a>
        <p class="text-sm leading-relaxed text-quiet dark:text-quiet-faint max-w-xs">
          Desenvolvedor de software com mais de 15 anos de experiência,
          construindo produtos web modernos e escaláveis.
        </p>
        <div class="flex gap-2">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target={social.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  social.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
                class="flex items-center justify-center h-9 w-9 rounded-full text-quiet dark:text-quiet-faint border border-transparent hover:border-hairline dark:hover:border-night-edge hover:bg-wall dark:hover:bg-night-wall hover:text-brand dark:hover:text-brand-lifted transition-all duration-200"
              >
                <social.icon className="h-[18px] w-[18px]" stroke={1.75} />
                <span class="sr-only">{social.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="space-y-4 flex flex-col items-center md:items-start">
        <h3
          class="text-xs font-semibold uppercase tracking-wider text-brand dark:text-brand-lifted"
        >
          Mapa do Site
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            siteLinks.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-4 flex flex-col items-center md:items-start">
        <a
          href="/projetos"
          class="group inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-brand dark:text-brand-lifted hover:text-brand-deep dark:hover:text-brand-lifted transition-colors"
        >
          Projetos
          <IconArrowUpRight
            className="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            stroke={2}
          />
        </a>
        <ul class="space-y-2.5 text-sm">
          {
            projects.map(({ slug, name }) => (
              <li>
                <a
                  href={new URL(`/project/${slug}`, Astro.url).toString()}
                  class="text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-4 flex flex-col items-center md:items-start">
        <a
          href="/plugins"
          class="group inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-brand dark:text-brand-lifted hover:text-brand-deep dark:hover:text-brand-lifted transition-colors"
        >
          Plugins WP
          <IconArrowUpRight
            className="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            stroke={2}
          />
        </a>
        <ul class="space-y-2.5 text-sm">
          {
            plugins.map(({ slug, name }) => (
              <li>
                <a
                  href={new URL(`/plugin/${slug}`, Astro.url).toString()}
                  class="text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-hairline dark:border-night-edge flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left"
    >
      <p class="text-xs text-quiet dark:text-quiet-faint">
        &copy; {currentYear} Airton Vancin. Todos os direitos reservados.
      </p>

      <div class="flex items-center gap-6">
        <nav class="flex gap-4 sm:gap-6">
          <a
            class="text-xs hover:underline underline-offset-4 text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors"
            href="/termos"
          >
            Termos de Uso
          </a>
          <a
            class="text-xs hover:underline underline-offset-4 text-quiet dark:text-quiet-faint hover:text-ink dark:hover:text-gallery-floor transition-colors"
            href="/politicas"
          >
            Políticas de Privacidade
          </a>
        </nav>
        <a
          href="#top"
          aria-label="Voltar ao topo"
          class="flex items-center justify-center h-8 w-8 rounded-full border border-hairline dark:border-night-edge text-quiet dark:text-quiet-faint hover:text-brand dark:hover:text-brand-lifted hover:border-brand-edge dark:hover:border-brand-deep transition-colors"
        >
          <IconArrowUp className="h-4 w-4" stroke={1.75} />
        </a>
      </div>
    </div>
  </div>
</footer>

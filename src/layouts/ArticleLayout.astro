---
/*
  One blog post, on the minimal shell: the narrow Plex column, a way back to
  /blog, the title as the two-line header, then the body, tags, sharing,
  related posts and comments as quiet `~/section` blocks.
*/
import { getCollection } from "astro:content";
import { slugify } from "@/helpers/slugify";
import MinimalPage from "@/components/MinimalPage.astro";
import PostList from "@/components/PostList.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import { breadcrumbJsonLd, PERSON_ID } from "@/helpers/siteIdentity";

const { id, frontmatter, readingTime } = Astro.props;
const pageUrl = Astro.url.href;
const pageId = Astro.url.pathname;

const currentTags: string[] = frontmatter.tags || [];

/*
  Related posts: most shared tags first, then newest. PostList re-sorts by date,
  so the score only decides which three make the cut.
*/
const relatedPosts = (await getCollection("blog"))
  .filter((post) => post.id !== id)
  .map((post) => ({
    post,
    score: (post.data.tags ?? []).filter((tag) => currentTags.includes(tag)).length,
  }))
  .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map(({ post }) => post);

const site = Astro.site || new URL("https://airtonvancin.com");
const lang = frontmatter.lang ?? "pt-BR";
const publishedDate = new Date(frontmatter.date);
const modifiedDate = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : undefined;

/*
  `frontmatter.image` is ImageMetadata now that the collection schema declares
  it with `image()`, so the absolute URL comes from `.src` — the build-hashed
  path of the optimized asset — rather than from the frontmatter string.
*/
const socialImage = frontmatter.image ? new URL(frontmatter.image.src, site).toString() : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: publishedDate.toISOString(),
  dateModified: (modifiedDate ?? publishedDate).toISOString(),
  image: socialImage,
  inLanguage: lang,
  keywords: currentTags.length ? currentTags.join(", ") : undefined,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  /*
    Author and publisher are `@id` references to the single Person node emitted
    site-wide by Layout, not fresh literals. Repeating the literal here is what
    previously described a new anonymous person on every post.
  */
  author: { "@id": new URL(PERSON_ID, site).toString() },
  publisher: { "@id": new URL(PERSON_ID, site).toString() },
};

/*
  FAQPage is bound to a `#faq` fragment rather than to the page URL: the page's
  primary entity is the BlogPosting, and two nodes both claiming the bare URL as
  their @id is the ambiguity that makes Google keep one and discard the other.
  Same reasoning as helpers/pluginJsonLd.ts.
*/
const faq: { question: string; answer: string }[] = frontmatter.faq ?? [];
const faqJsonLd = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      inLanguage: lang,
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }
  : undefined;

const faqHeading = lang === "pt-BR" ? "Perguntas frequentes" : "Frequently asked questions";

const breadcrumb = breadcrumbJsonLd(
  [
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: frontmatter.title, path: pageId },
  ],
  site,
  pageUrl,
);

/*
  Long editorial headlines get a short `seoTitle` for the <title> tag. The brand
  suffix is deliberately terse: at 28 characters the old
  "| Blog Airton Vancin Junior" left roughly 32 for the headline itself, which
  truncated every post in the SERP.
*/
const pageTitle = `${frontmatter.seoTitle ?? frontmatter.title} | Airton Vancin`;

// Chrome is English across the minimal pages, as on /blog; the body keeps its own language.
const dateLabel = publishedDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const meta = [dateLabel, readingTime && `${readingTime} min read`].filter(Boolean).join(" · ");
---

<MinimalPage
  title={pageTitle}
  description={frontmatter.description}
  heading={frontmatter.title}
  lang={lang}
  image={socialImage}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  backLabel="← Writing"
  backHref="/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />
    {faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <Fragment slot="header">
    <p class="text-sm text-quiet dark:text-quiet-lifted" lang="en">
      <time datetime={publishedDate.toISOString()}>{meta}</time>
    </p>
    <p class="mt-6 text-base leading-relaxed text-ink-secondary dark:text-quiet-lifted">
      {frontmatter.description}
    </p>
  </Fragment>

  <article class="prose post-body mb-14">
    <slot />
    {
      faq.length > 0 && (
        <section id="faq">
          <h2>{faqHeading}</h2>
          {faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))}
        </section>
      )
    }
  </article>

  {
    currentTags.length > 0 && (
      <section class="mb-14" lang="en">
        <h2 class="term-title"><span aria-hidden="true">~/</span>tags</h2>
        <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
          {currentTags.map((tag) => (
            <a href={`/blog/tag/${slugify(tag)}/`} class="quiet-link">#{tag}</a>
          ))}
        </p>
      </section>
    )
  }

  <section class="mb-14" lang="en">
    <h2 class="term-title"><span aria-hidden="true">~/</span>share</h2>
    <ShareButtons url={pageUrl} title={frontmatter.title} />
  </section>

  {
    relatedPosts.length > 0 && (
      <section class="mb-4" lang="en">
        <h2 class="term-title"><span aria-hidden="true">~/</span>related</h2>
        <PostList posts={relatedPosts} />
      </section>
    )
  }

  <section class="mb-14 text-sm text-quiet dark:text-quiet-lifted" lang="en">
    <p>
      Need deploys without downtime? See <a href="/zero-downtime/" class="quiet-link">Front-end Zero Downtime</a>.
    </p>
  </section>

  <!-- Disqus injects its own theming, so the thread pins itself to the light scheme. -->
  <section class="mb-14" lang="en">
    <h2 class="term-title"><span aria-hidden="true">~/</span>comments</h2>
    <div id="disqus_thread" style="color-scheme: light;"></div>
    <noscript>
      <p class="text-sm text-quiet">
        Enable JavaScript to see the <a href="https://disqus.com/?ref_noscript" class="quiet-link">Disqus comments</a>.
      </p>
    </noscript>
  </section>
</MinimalPage>

<script is:inline define:vars={{ pageUrl, pageId }}>
  var disqus_config = function () {
    this.page.url = pageUrl;
    this.page.identifier = pageId;
  };

  /*
    Disqus is loaded only when the thread is about to scroll into view. Most
    readers arrive from search, read one post and leave without reaching the
    comments, so loading it eagerly cost every one of them its scripts, its
    trackers and its own ads for nothing.
  */
  (function () {
    var thread = document.getElementById("disqus_thread");
    if (!thread) return;

    function load() {
      var d = document,
        s = d.createElement("script");
      s.src = "https://airtonvancin.disqus.com/embed.js";
      s.setAttribute("data-timestamp", +new Date());
      (d.head || d.body).appendChild(s);
    }

    if (!("IntersectionObserver" in window)) return load();

    var observer = new IntersectionObserver(
      function (entries) {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();
        load();
      },
      { rootMargin: "600px 0px" },
    );
    observer.observe(thread);
  })();

  /*
    Manual ad units injected into the post body by rehypeInArticleAd. Each <ins>
    needs its own push; Auto Ads only fills slots of its own.
  */
  document.querySelectorAll("ins.adsbygoogle[data-ad-slot]").forEach(function () {
    (window.adsbygoogle = window.adsbygoogle || []).push({});
  });
</script>

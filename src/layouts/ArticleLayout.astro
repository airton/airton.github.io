---
import { dateFormat } from "@/helpers/dateFormat";
import { slugify } from "@/helpers/slugify";
import Layout from "@/layouts/Layout.astro";
import ZeroDowntimeCTA from "@/components/ZeroDowntimeCTA.astro";
import RecentPosts from "@/components/RecentPosts.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import type { MarkdownInstance } from "astro";

const { frontmatter, readingTime } = Astro.props;
const pageUrl = Astro.url.href;
const pageId = Astro.url.pathname;

const postImports = import.meta.glob("../content/blog/*.mdx", { eager: true });
const allPosts = Object.values(postImports).map((post) => {
  const typedPost = post as MarkdownInstance<Record<string, any>> & {
    file: string;
  };
  const url = typedPost.file.split("/src/content")[1].replace(".mdx", "");
  return {
    ...typedPost,
    url,
  };
});

const currentTags = frontmatter.tags || [];

const scoredPosts = allPosts.map((post) => {
  let score = 0;
  const postTags = post.frontmatter.tags || [];

  // Point for shared tags
  postTags.forEach((tag: string) => {
    if (currentTags.includes(tag)) score += 1;
  });

  return { ...post, score };
});

const sortedPosts = scoredPosts
  .filter((post) => post.url !== Astro.url.pathname) // Remove current post
  .sort((a, b) => {
    // Sort by score first (descending)
    if (b.score !== a.score) return b.score - a.score;
    // Then by date (descending)
    return (
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf()
    );
  });

const relatedPosts = sortedPosts.slice(0, 3);

const site = Astro.site || new URL("https://airtonvancin.com");
const publishedDate = new Date(frontmatter.date);
const modifiedDate = frontmatter.updatedDate
  ? new Date(frontmatter.updatedDate)
  : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: publishedDate.toISOString(),
  dateModified: (modifiedDate ?? publishedDate).toISOString(),
  image: frontmatter.image
    ? new URL(frontmatter.image, site).toString()
    : undefined,
  inLanguage: "pt-BR",
  keywords: currentTags.length ? currentTags.join(", ") : undefined,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  author: {
    "@type": "Person",
    name: "Airton Vancin Junior",
    url: new URL("/sobre/", site).toString(),
  },
  publisher: {
    "@type": "Person",
    name: "Airton Vancin Junior",
    url: site.toString(),
  },
};
---

<Layout
  title={`${frontmatter.title} | Blog Airton Vancin Junior`}
  description={frontmatter.description}
  image={frontmatter.image}
  type="article"
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div
    class="w-full py-12 md:py-24 lg:py-32 bg-gallery-floor flex justify-center"
  >
    <div class="container px-4 md:px-6 max-w-4xl">
      <div
        class="flex flex-col lg:flex-row items-center justify-center gap-4 space-y-4 text-center"
      >
        <div class="flex flex-col items-center space-y-4 text-center">
          <div class="space-y-2">
            <h1
              class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl lg:text-6xl/none text-ink"
            >
              {frontmatter.title}
            </h1>
            <p
              class="mx-auto max-w-[700px] text-ink md:text-xl dark:text-ink"
            >
              {frontmatter.description}
            </p>
            <p
              class="mx-auto max-w-[700px] text-ink md:text-sm dark:text-ink"
            >
              {dateFormat(frontmatter.date)}
              {readingTime && ` · ${readingTime} min de leitura`}
            </p>
            {
              currentTags.length > 0 && (
                <div class="flex flex-wrap justify-center gap-2 pt-2">
                  {currentTags.map((tag: string) => (
                    <a
                      href={`/blog/tag/${slugify(tag)}`}
                      class="inline-flex items-center rounded-full bg-ink/5 hover:bg-ink/10 px-3 py-1 text-xs font-medium text-ink-secondary transition-colors"
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div
    class="w-full px-4 md:px-6 py-8 md:py-12 lg:py-16 flex justify-center bg-wall"
  >
    <article
      class="prose prose-slate prose-lg max-w-4xl w-full
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink
        prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-hairline prose-h2:pb-2
        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
        prose-h4:text-xl prose-h4:mt-6 prose-h4:mb-2
        prose-h5:text-lg prose-h5:mt-4 prose-h5:mb-2
        prose-h6:text-base prose-h6:mt-4 prose-h6:mb-2 prose-h6:uppercase prose-h6:tracking-wide
        prose-p:text-ink-secondary prose-p:leading-relaxed prose-p:mb-4
        prose-a:text-brand prose-a:font-medium prose-a:no-underline hover:prose-a:underline hover:prose-a:text-brand-deep
        prose-strong:font-bold prose-strong:text-ink
        prose-em:italic prose-em:text-ink-secondary
        prose-ul:list-disc prose-ul:pl-6 prose-ul:my-4 prose-ul:space-y-2
        prose-ol:list-decimal prose-ol:pl-6 prose-ol:my-4 prose-ol:space-y-2
        prose-li:text-ink-secondary prose-li:leading-relaxed
        prose-blockquote:border-l-4 prose-blockquote:border-brand prose-blockquote:bg-gallery-floor prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:my-6 prose-blockquote:rounded-r-lg prose-blockquote:italic prose-blockquote:text-ink-secondary
        prose-code:bg-hairline-faint prose-code:text-code-magenta prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-ink prose-pre:text-gallery-floor prose-pre:rounded-xl prose-pre:shadow-xl prose-pre:my-6 prose-pre:overflow-x-auto
        prose-table:w-full prose-table:my-6 prose-table:border-collapse prose-table:rounded-lg
        prose-thead:bg-hairline-faint
        prose-th:text-left prose-th:font-semibold prose-th:text-ink prose-th:p-3 prose-th:border prose-th:border-hairline
        prose-td:p-3 prose-td:border prose-td:border-hairline prose-td:text-ink-secondary
        prose-tr:even:bg-gallery-floor
        prose-img:rounded-xl prose-img:shadow-lg prose-img:my-6
        prose-hr:border-hairline prose-hr:my-8"
    >
      <slot />
    </article>
  </div>

  <div class="w-full px-4 md:px-6 pb-8 flex justify-center bg-wall">
    <div class="max-w-4xl w-full border-t border-hairline pt-8">
      <ShareButtons url={pageUrl} title={frontmatter.title} />
    </div>
  </div>

  <RecentPosts posts={relatedPosts} title="Posts Relacionados" />

  <!-- Disqus Comments Section -->
  <!-- Disqus injects its own theming, so this block pins itself to the light
       reading surface rather than inheriting it. -->
  <div class="w-full bg-wall text-ink-secondary py-12" style="color-scheme: light;">
    <div class="container px-4 md:px-6 max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold mb-6 text-ink">
        Comentários
      </h2>
      <div id="disqus_thread" style="color-scheme: light;"></div>
      <noscript>
        Por favor, habilite o JavaScript para ver os
        <a href="https://disqus.com/?ref_noscript">comentários do Disqus.</a>
      </noscript>
    </div>
  </div>

  <ZeroDowntimeCTA />
</Layout>

<script is:inline define:vars={{ pageUrl, pageId }}>
  var disqus_config = function () {
    this.page.url = pageUrl;
    this.page.identifier = pageId;
  };

  (function () {
    var d = document,
      s = d.createElement("script");
    s.src = "https://airtonvancin.disqus.com/embed.js";
    s.setAttribute("data-timestamp", +new Date());
    (d.head || d.body).appendChild(s);
  })();
</script>

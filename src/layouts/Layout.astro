---
import Footer from "@/components/Footer.astro";
import { Navigation } from "@/components/Navigation";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: Date;
  modifiedDate?: Date;
  /**
   * BCP-47 tag for the page's main content. The site is Portuguese, so that is
   * the default — but a page whose body is English has to say so, or `lang`
   * and the text disagree and both screen readers and search engines take the
   * attribute's word over the content's.
   */
  lang?: string;
}

const {
  title = "airtonvancin.com",
  description = "Software Engineer apaixonado por criar soluções web modernas e escaláveis. Especializado em React, Node.js, TypeScript e arquitetura de software.",
  image = "/web-app-manifest-512x512.png",
  type = "website",
  publishedDate,
  modifiedDate,
  lang = "pt-BR",
} = Astro.props;

const site = Astro.site || new URL("https://airtonvancin.com");
const canonicalURL = new URL(Astro.url.pathname, site);
const socialImage = new URL(image, site);

/*
  Open Graph wants a language_TERRITORY locale — `pt_BR`, not the `pt-BR` of
  the lang attribute, and never a bare `en`, which crawlers ignore. A bare
  language tag is the right value for `lang` though, so the territory is
  supplied here rather than forced into the frontmatter.
*/
const OG_TERRITORY: Record<string, string> = { pt: "pt_BR", en: "en_US" };
const ogLocale = lang.includes("-")
  ? lang.replace("-", "_")
  : (OG_TERRITORY[lang] ?? lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload Avatar -->
    <link rel="preload" href="/assets/images/profile-avatar.avif" as="image" />

    <!--
      Preload only the two faces that render above the fold on every page.
      JetBrains Mono is deliberately not here: it appears inside article code
      blocks, well below the fold, and preloading it would compete with the
      text the visitor is waiting for.
    -->
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Airton Vancin Junior" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Airton Vancin | Blog & Artigos de Tecnologia"
      href={new URL("rss.xml", site)}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Airton Vancin Junior" />
    {
      publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }
    {
      modifiedDate && (
        <meta
          property="article:modified_time"
          content={modifiedDate.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Theme Color -->
    <meta name="theme-color" content="#1A1A17" />
    <meta name="msapplication-TileColor" content="#1A1A17" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1HNLJCL2MF"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-1HNLJCL2MF");
    </script>

    <!-- Google AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3553535106347103"
      crossorigin="anonymous"></script>
  </head>
  <body>
    <div
      class="flex flex-col min-h-screen bg-wall dark:bg-night-wall text-ink dark:text-gallery-floor transition-colors duration-300"
    >
      <header
        class="m-auto p-2 flex items-center justify-center fixed w-full z-50"
      >
        <Navigation client:idle />
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
